# Process long options.  Handle options names case-insensitive
# and allow either -, _, or neither in names.
process_option() {
    local optstr=${1:-}
    local option=
    local value=
    IFS=$'=' read -r option value <<< "$optstr"
    # Normalize the option name to use - instead of _
    option=${option//_/-}
    option=${option//-/}
    # Convert the option to lowercase for case-insensitive matching
    case "${option,,}" in
	batchid)   BATCH_ID=$value; BATCH_ID_SET=1 ;;
	delete)    [[ -n "$value" ]] || fatal "--delete requires a batch ID (e.g. --delete=abc123)"
		   DELETE_BATCH=$value ;;
	deleteall) DELETE_ALL=1 ;;
	yes)       CONFIRM_DELETE=1 ;;
	datasourc*) DATASOURCE=$value ;;
	dvurl)     DV_URL=$value; DATASOURCE= ;;
	storagecl*) STORAGE_CLASS=$value; STORAGE_CLASS_SET=1 ;;
	storagesi*|storage) STORAGE_SIZE=$value ;;
	datadisksi*|datadisksize) DATA_DISK_SIZE=$value ;;
	accessmod*|accessmode) ACCESS_MODE=$value; ACCESS_MODE_SET=1 ;;
	volumemod*|volumemode) VOLUME_MODE=$value; VOLUME_MODE_SET=1 ;;
	snapshotcl*) SNAPSHOT_CLASS=$value; SNAPSHOT_CLASS_SET=1; USE_SNAPSHOT=1; SNAPSHOT_EXPLICITLY_SET=1 ;;
	nosnapshot) USE_SNAPSHOT=0; SNAPSHOT_EXPLICITLY_SET=1 ;;
	pvc*)      BASE_PVC_NAME=$value; PVC_BASE_NAME_SET=1 ;;
	base*)	   VM_BASENAME=$value; BASENAME_SET=1 ;;
	core*)	   VM_CPU_CORES=$value ;;
	mem*)	   VM_MEMORY=$value ;;
	firmware)
	    case "${value,,}" in
		bios|efi) VM_FIRMWARE=${value,,} ;;
		*) fatal "Invalid --firmware='$value'; use bios or efi" ;;
	    esac
	    ;;
	requestm*) VM_MEMORY_REQUEST=$value ;;
	requestc*) VM_CPU_REQUEST=$value ;;
	vmsper*)   NUM_VMS_PER_NAMESPACE=$value ;;
	vms*)	   NUM_VMS=$value ;;
	namesp*)   NUM_NAMESPACES=$value ;;
	nssequentialcreation) case "${value,,}" in
		       '') NS_SEQUENTIAL_CREATION=1 ;;  # --ns-sequential-creation with no value
		       0|1|true|false|yes|no|on|off) case "${value,,}" in
		           0|false|no|off) NS_SEQUENTIAL_CREATION=0 ;;
		           *) NS_SEQUENTIAL_CREATION=1 ;;
		           esac ;;
		       *) fatal "Invalid --ns-sequential-creation value '$value'; use true, false, 1, 0, yes, no, on, or off" ;;
		   esac ;;
	udnl2)
	    UDN_L2=1
	    if [[ -n "$value" ]]; then
		SUBNET=$value
		validate_subnet "$SUBNET"
	    fi
	    ;;
	service)
	    parse_service_value "$value"
	    ;;
	runstrat*) RUN_STRATEGY=$value ;;
	wait)	   case "${value,,}" in
		       '') WAIT=1 ;;  # --wait with no value
		       0|1|true|false|yes|no|on|off) case "${value,,}" in
		           0|false|no|off) WAIT=0 ;;
		           *) WAIT=1 ;;
		           esac ;;
		       *) fatal "Invalid --wait value '$value'; use true, false, 1, 0, yes, no, on, or off" ;;
		   esac ;;
	waitssh)   case "${value,,}" in
		       '') WAIT_SSH=1; WAIT=1 ;;
		       0|1|true|false|yes|no|on|off) case "${value,,}" in
		           0|false|no|off) WAIT_SSH=0 ;;
		           *) WAIT_SSH=1; WAIT=1 ;;
		           esac ;;
		       *) fatal "Invalid --wait-ssh value '$value'; use true, false, 1, 0, yes, no, on, or off" ;;
		   esac ;;
	cloudinit) CLOUDINIT_FILE=$value ;;
	env)
	    # Keep full KEY=VAL (including KEY= and KEY=a=b). Do not use $value from
	    # IFS== read — a trailing '=' is dropped (RESULT_SERVER_URL= → RESULT_SERVER_URL).
	    if [[ "$optstr" == env=* ]]; then
		GUEST_ENV_ARR+=("${optstr#env=}")
	    else
		GUEST_ENV_ARR+=("$value")
	    fi
	    ;;
	containerdisk) CONTAINERDISK_IMAGE=${value:-quay.io/containerdisks/fedora:latest}
		   DATASOURCE=; DV_URL= ;;
	createex*) RECREATE_EXISTING_VMS=1 ;;
	profile)   PROFILE_TARGET=${value:-all} ;;
	*) 	   fatal "Error: unrecognized option '--${optstr%%=*}'. Run '$0 -h' to see all options." ;;
    esac
}

# Normalize --env VAL to --env=VAL so getopts receives a value (space-separated form)
_argv=()
for ((_i=1; _i<=$#; _i++)); do
    _arg="${@:_i:1}"
    if [[ "$_arg" == --env && _i -lt $# ]]; then
	_next="${@:_i+1:1}"
	if [[ "$_next" != --* ]]; then
	    _argv+=("--env=$_next")
	    ((_i++))
	    continue
	fi
    fi
    _argv+=("$_arg")
done
set -- "${_argv[@]}"

# process all the options one by one, - is treated as the option"-"
# Leading : suppresses getopts default error so we can show our own message.
while getopts ':nqyh-:' opt "$@" ; do
    case "$opt" in
	n) wet_run=0	    ;;
	q) quiet=1; wet_run=0	    ;;
	y) CONFIRM_DELETE=1	    ;;
	h) help			    ;;
	-) process_option "$OPTARG" ;;
	*) fatal "Error: unrecognized option '-${OPTARG:-$opt}'. Run '$0 -h' to see all options." ;;
    esac
done

# clean all the optional arguments that have been processed by getopts so that the positional arguments are now the remaining arguments
shift $((OPTIND-1))

derive_defaults
validate_args "$@"

# Function to log with timestamp
# Output may be provided on command line; if not, it is
# read line by line from stdin with timestamp prepended.
# Only timestamp if we're doing something; if it's a dry
# run, the timestamp won't be interesting.
_log_message() {
    # avoid conflicts with the global OPTIND variable
    local -i OPTIND=0
    local -i from_stdin=0
    while getopts v- opt "$@" ; do
	case "$opt" in
	    -) from_stdin=1 ;;
	    *)		    ;;
	esac
    done
    shift $((OPTIND-1))
    if ((from_stdin)) ; then
	local line
	while IFS= read -r line ; do
	    if ((wet_run)) ; then
		TZ=UTC printf "%(%Y-%m-%dT%H:%M:%S)TZ %s\n" -1 "$line"
	    else
		echo "$line"
	    fi
	done
    else
	if ((wet_run)) ; then
	    TZ=UTC printf "%(%Y-%m-%dT%H:%M:%S)TZ %s\n" -1 "$*"
	else
	    echo "$*"
	fi
    fi
}

log_message() {
    if ((wet_run)) ; then
	_log_message "$*" | tee -a "$LOG_FILE"
    else
	_log_message "$*"
    fi
}

setup_logging() {
    STARTED_AT=$(date -u +%s)
    LOG_FILE="${LOG_DIR}/$(join_name "$BATCH_ID" "$VM_BASENAME")-$(date -u +%Y-%m-%dT%H:%M:%SZ).log"
    if ((wet_run)) ; then
	if [[ ! -d "$LOG_DIR" ]]; then
	    mkdir -p "$LOG_DIR"
	    echo "Created log directory: $LOG_DIR"
	fi
	log_message "Log file created: ${C_VAL}$LOG_FILE${C_RST}"
    else
	if (( ! quiet )) ; then
	    if [[ ! -d "$LOG_DIR" ]]; then
		mkdir -p "$LOG_DIR"
	    fi
	    DRYRUN_FILE="${LOG_DIR}/${BATCH_ID}-dryrun.yaml"
	fi
    fi
}


# Run oc whoami with timeout; prints "Checking..." every 3s while waiting.
# Returns: 0 = success, 124 = timeout, non-zero = failure.
# On failure (non-zero, non-124), sets OC_WHOAMI_ERR to the stderr from oc.
check_oc_connectivity() {
	OC_WHOAMI_ERR=""
	local oc_timeout=${OC_CONNECT_TIMEOUT:-30}
	local stderr_file
	stderr_file=$(mktemp)
	trap 'rm -f "${stderr_file:-}" 2>/dev/null; trap - RETURN' RETURN

	oc whoami >/dev/null 2>"$stderr_file" &
	local oc_pid=$!
	local elapsed=0
	local rc=0

	while ((elapsed < oc_timeout)); do
		if ! kill -0 "$oc_pid" 2>/dev/null; then
			wait "$oc_pid" 2>/dev/null || rc=$?
			break
		fi
		if ((elapsed > 0 && elapsed % 3 == 0)); then
			echo "${C_VAL}Checking OpenShift cluster connection...${C_RST}"
		fi
		sleep 1
		((elapsed += 1))
	done

	if kill -0 "$oc_pid" 2>/dev/null; then
		kill "$oc_pid" 2>/dev/null || true
		wait "$oc_pid" 2>/dev/null || true
		return 124
	fi

	if ((rc != 0)); then
		OC_WHOAMI_ERR=$(cat "$stderr_file" 2>/dev/null || true)
	fi
	return "$rc"
}

# Ensure oc is installed and cluster is reachable. Exits with fatal if not.
# Reused by check_prerequisites and by the delete path.
ensure_oc_ready() {
	if [[ -z "$(type -t oc)" ]] ; then
		fatal "Error: oc command is not installed on system"
	fi
	local rc=0
	check_oc_connectivity || rc=$?
	if ((rc == 124)) ; then
		fatal "Error: timed out reaching OpenShift cluster (${C_VAL}${OC_CONNECT_TIMEOUT:-30}s${C_RST}) -- check network connectivity"
	elif ((rc != 0)) ; then
		if [[ -n "${OC_WHOAMI_ERR:-}" ]] ; then
			fatal "Error: ${OC_WHOAMI_ERR}"
		else
			fatal "Error: not logged into an OpenShift cluster (run 'oc login' first)"
		fi
	fi
}

# Check for prerequisites: oc CLI, OpenShift Virtualization,
# ODF storage, and the configured storage class.
# Reports all missing prerequisites before exiting.
check_prerequisites() {
    local -i errors=0

    ensure_oc_ready

	if ! oc get ns openshift-cnv >/dev/null 2>&1 ; then
	    echo "${C_ERR}Error:${C_RST} OpenShift Virtualization is not installed (openshift-cnv namespace not found)"
	    ((errors++))
	fi

	if [[ -z "$CONTAINERDISK_IMAGE" || -n "$DATA_DISK_SIZE" ]] ; then
	    if [[ -z "$CONTAINERDISK_IMAGE" ]] && ((USE_SNAPSHOT)) ; then
		if ! oc get ns openshift-storage >/dev/null 2>&1 ; then
		    echo "${C_ERR}Error:${C_RST} OpenShift Data Foundation is not installed (openshift-storage namespace not found)"
		    echo "  ${C_WARN}Hint:${C_RST} use --no-snapshot to skip VolumeSnapshot-based cloning"
		    ((errors++))
		fi
	    fi

	    if ! oc get storageclass "$STORAGE_CLASS" >/dev/null 2>&1 ; then
		echo "${C_ERR}Error:${C_RST} storage class ${C_VAL}'$STORAGE_CLASS'${C_RST} not found"
		echo "  Available storage classes:"
		oc get storageclass --no-headers 2>/dev/null | awk '{print "    " $1}' || true
		((errors++))
	    fi

	    if [[ -z "$CONTAINERDISK_IMAGE" ]] && ((USE_SNAPSHOT)) ; then
		if ! oc get volumesnapshotclass "$SNAPSHOT_CLASS" >/dev/null 2>&1 ; then
		    echo "${C_ERR}Error:${C_RST} volume snapshot class ${C_VAL}'$SNAPSHOT_CLASS'${C_RST} not found"
		    echo "  Available volume snapshot classes:"
		    oc get volumesnapshotclass --no-headers 2>/dev/null | awk '{print "    " $1}' || true
		    echo "  ${C_WARN}Hint:${C_RST} use --no-snapshot to skip VolumeSnapshot-based cloning"
		    ((errors++))
		fi
	    fi

	    if [[ -z "$CONTAINERDISK_IMAGE" && -n "$DATASOURCE" ]] ; then
		if ! oc get datasource "$DATASOURCE" -n "$DATASOURCE_NS" >/dev/null 2>&1 ; then
		    echo "${C_ERR}Error:${C_RST} DataSource ${C_VAL}'$DATASOURCE'${C_RST} not found in namespace ${C_VAL}'$DATASOURCE_NS'${C_RST}"
		    echo "  Available DataSources:"
		    oc get datasource -n "$DATASOURCE_NS" --no-headers 2>/dev/null | awk '{print "    " $1}' || true
		    ((errors++))
		fi
	    fi
	fi

    if ((errors > 0)) ; then
	fatal "Prerequisite check failed with ${C_VAL}$errors${C_RST} error(s)"
    fi

    if [[ -n "$CONTAINERDISK_IMAGE" ]] ; then
	log_message "${C_OK}Prerequisites OK:${C_RST} oc CLI, OpenShift Virtualization (container disk mode)"
    else
	local snap_msg=""
	if ((USE_SNAPSHOT)) ; then
	    snap_msg=", snapshot class ${C_VAL}'$SNAPSHOT_CLASS'${C_RST}"
	else
	    snap_msg=" (no-snapshot mode)"
	fi
	log_message "${C_OK}Prerequisites OK:${C_RST} oc CLI, OpenShift Virtualization, storage class ${C_VAL}'$STORAGE_CLASS'${C_RST}${snap_msg}"
    fi
}

# Auto-detect the PVC access mode from the CDI StorageProfile.
# CDI creates a StorageProfile for each StorageClass containing
# the recommended accessModes and volumeMode.  Prefer the access
# mode matching the selected VOLUME_MODE (default Block).  Falls
# back to the first listed access mode, then to the existing
# ACCESS_MODE default.
# Skipped when the user explicitly sets --access-mode.
detect_access_mode() {
    if ((ACCESS_MODE_SET)) ; then
	log_message "Access mode explicitly set to: ${C_VAL}$ACCESS_MODE${C_RST}"
	return
    fi

    local detected=""

    # Prefer the access mode for the selected volumeMode
    detected=$(oc get storageprofile "$STORAGE_CLASS" \
	-o go-template="{{range .status.claimPropertySets}}{{if eq .volumeMode \"$VOLUME_MODE\"}}{{index .accessModes 0}}{{break}}{{end}}{{end}}" \
	2>/dev/null) || true

    # Fall back to the first access mode in the StorageProfile
    if [[ -z "$detected" ]] ; then
	detected=$(oc get storageprofile "$STORAGE_CLASS" \
	    -o jsonpath='{.status.claimPropertySets[0].accessModes[0]}' \
	    2>/dev/null) || true
    fi

    if [[ -n "$detected" ]] ; then
	ACCESS_MODE="$detected"
	log_message "Auto-detected access mode ${C_VAL}'$ACCESS_MODE'${C_RST} from StorageProfile for ${C_VAL}'$STORAGE_CLASS'${C_RST} (volumeMode ${C_VAL}$VOLUME_MODE${C_RST})"
    else
	log_message "${C_WARN}Warning:${C_RST} Could not detect access mode from StorageProfile for ${C_VAL}'$STORAGE_CLASS'${C_RST}; using default: ${C_VAL}$ACCESS_MODE${C_RST}"
    fi

    # Detect WaitForFirstConsumer storage classes.  With WFFC the base
    # DataVolume PVC won't bind until a consumer Pod is scheduled.
    # Snapshot mode is incompatible with WFFC because the base PVC has
    # no consumer Pod -- it would deadlock.  Auto-disable snapshots and
    # fall back to direct DataSource clone which has no base PVC.
    local bind_mode
    bind_mode=$(oc get storageclass "$STORAGE_CLASS" -o jsonpath='{.volumeBindingMode}' 2>/dev/null) || true
    if [[ "$bind_mode" == "WaitForFirstConsumer" ]] ; then
	WAIT_FOR_FIRST_CONSUMER=1
	log_message "Storage class ${C_VAL}'$STORAGE_CLASS'${C_RST} uses WaitForFirstConsumer binding."
	if ((USE_SNAPSHOT)) ; then
	    USE_SNAPSHOT=0
	    log_message "  ${C_WARN}Warning:${C_RST} Disabling snapshot mode -- snapshots require a bound base PVC,"
	    log_message "  but WFFC storage won't bind until a consumer Pod is scheduled."
	    log_message "  Falling back to direct DataSource clone (no base PVC needed)."
	else
	    log_message "  Will skip waiting for base DataVolume and proceed to VM creation"
	    log_message "  so that consumer Pods can trigger PVC binding."
	fi
    fi
}

# Resolve a built-in template path and fatal if the file is missing.
_require_builtin() {
    local role=$1 path=$2
    [[ -f "$path" ]] || fatal "No $role template found: $path"
    echo "$path"
}

# Validate that all templates required for the current clone mode exist,
# and cache their paths for creation functions.
validate_required_templates() {
    local T=$BUILTIN_TEMPLATES_DIR

    TEMPLATE_CACHE[namespace]=$(_require_builtin namespace "$T/namespace.yaml")

    if [[ -n "$CONTAINERDISK_IMAGE" ]]; then
	TEMPLATE_CACHE[vm]=$(_require_builtin vm "$T/vm-containerdisk.yaml")
    elif ((USE_SNAPSHOT)); then
	TEMPLATE_CACHE[volumesnapshot]=$(_require_builtin volumesnapshot "$T/volumesnap.yaml")
	TEMPLATE_CACHE[vm]=$(_require_builtin vm "$T/vm-snap.yaml")
    elif [[ -n "$DATASOURCE" ]]; then
	TEMPLATE_CACHE[vm]=$(_require_builtin vm "$T/vm-datasource.yaml")
    else
	TEMPLATE_CACHE[vm]=$(_require_builtin vm "$T/vm-clone.yaml")
    fi

    if ((UDN_L2)); then
	TEMPLATE_CACHE[udn-l2]=$(_require_builtin udn-l2 "$T/udn-l2.yaml")
	if [[ -n "$CONTAINERDISK_IMAGE" ]]; then
	    TEMPLATE_CACHE[vm-udn]=$(_require_builtin vm-udn "$T/vm-containerdisk-udn.yaml")
	elif ((USE_SNAPSHOT)); then
	    TEMPLATE_CACHE[vm-udn]=$(_require_builtin vm-udn "$T/vm-snap-udn.yaml")
	elif [[ -n "$DATASOURCE" ]]; then
	    TEMPLATE_CACHE[vm-udn]=$(_require_builtin vm-udn "$T/vm-datasource-udn.yaml")
	else
	    TEMPLATE_CACHE[vm-udn]=$(_require_builtin vm-udn "$T/vm-clone-udn.yaml")
	fi
    fi

    if ((VM_SERVICE)); then
	TEMPLATE_CACHE[vm-service]=$(_require_builtin vm-service "$T/vm-service.yaml")
    fi

    if [[ -z "$CONTAINERDISK_IMAGE" ]]; then
	if [[ -n "$DATASOURCE" ]]; then
	    if ((USE_SNAPSHOT)); then
		TEMPLATE_CACHE[dv]=$(_require_builtin dv "$T/dv-datasource.yaml")
	    fi
	else
	    if [[ -z "$DV_URL" ]]; then
		fatal "Either --datasource, --dv-url, or --containerdisk must be set"
	    fi
	    TEMPLATE_CACHE[dv]=$(_require_builtin dv "$T/dv.yaml")
	fi
    fi

    if [[ -n "$CLOUDINIT_FILE" ]]; then
	TEMPLATE_CACHE[cloudinit-secret]=$(_require_builtin cloudinit-secret "$T/cloudinit-secret.yaml")
	if [[ ! -f "$CLOUDINIT_FILE" ]]; then
	    fatal "Cloud-init file not found: $CLOUDINIT_FILE"
	fi
    fi
}

validate_delete_and_profile_options() {
    # Validate batch ID format for --delete (Kubernetes label value rules:
    # alphanumeric, dots, hyphens, underscores; 1-63 chars; starts/ends alphanumeric).
    # This blocks wildcards, commas, spaces, and other special characters that
    # could confuse label selectors or cause unexpected behavior.
    if [[ -n "$DELETE_BATCH" ]] ; then
	if ! [[ "$DELETE_BATCH" =~ ^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,61}[a-zA-Z0-9])?$ ]]; then
	    fatal "Invalid batch ID '$DELETE_BATCH': must be 1-63 alphanumeric characters (plus . _ -), starting and ending with alphanumeric"
	fi
    fi

    # --delete and --delete-all are mutually exclusive
    if [[ -n "$DELETE_BATCH" ]] && ((DELETE_ALL)) ; then
	fatal "Cannot use --delete and --delete-all together"
    fi

    # --profile is incompatible with --delete and --delete-all
    if [[ -n "$PROFILE_TARGET" ]] ; then
	if [[ -n "$DELETE_BATCH" ]] || ((DELETE_ALL)) ; then
	    fatal "Cannot use --profile with --delete or --delete-all"
	fi
	case "$PROFILE_TARGET" in
	    all|virt-api|virt-controller|virt-handler|virt-operator) ;;
	    *) fatal "Invalid --profile value '$PROFILE_TARGET'. Valid values: virt-api, virt-controller, virt-handler, virt-operator, all" ;;
	esac
    fi
}

# Apply workload/cloudinit-default.yaml when --cloudinit was omitted.
# Safe to call more than once; no-ops if CLOUDINIT_FILE is already set.
apply_default_cloudinit_if_needed() {
    if [[ -n "$CLOUDINIT_FILE" ]] ; then
	return 0
    fi
    CLOUDINIT_FILE="$(dirname "$0")/workload/cloudinit-default.yaml"
    if [[ ! -f "$CLOUDINIT_FILE" ]] ; then
	fatal "Default cloud-init file not found: $CLOUDINIT_FILE"
    fi
    log_message "No --cloudinit specified; applying default cloud-init (root password: ${C_VAL}password${C_RST}, boot timestamp only)"
}

# Inject DEFAULT_RESULT_SERVER_URL unless the user already passed RESULT_SERVER_URL=
# (including empty to disable). Safe to call more than once.
ensure_default_result_server_url() {
    local e
    for e in "${GUEST_ENV_ARR[@]+"${GUEST_ENV_ARR[@]}"}"; do
	case "$e" in
	    RESULT_SERVER_URL|RESULT_SERVER_URL=*) return 0 ;;
	esac
    done
    GUEST_ENV_ARR+=("RESULT_SERVER_URL=${DEFAULT_RESULT_SERVER_URL}")
}

# True (0) if a non-empty RESULT_SERVER_URL is configured (default or --env).
# Used to skip expensive cluster-wide DV/PVC/VS collects for progress manifest
# POSTs when no one is listening.
_result_server_url_configured() {
    ensure_default_result_server_url
    local e
    for e in "${GUEST_ENV_ARR[@]+"${GUEST_ENV_ARR[@]}"}"; do
	case "$e" in
	    RESULT_SERVER_URL=*)
		[[ -n "${e#RESULT_SERVER_URL=}" ]] && return 0
		return 1
		;;
	esac
    done
    return 1
}

prepare_creation() {
    # Skip creation-specific checks when deleting
    [[ -n "$DELETE_BATCH" ]] || ((DELETE_ALL)) && return

    if ((wet_run)) ; then
	check_prerequisites
    fi

    if [[ -z "$CONTAINERDISK_IMAGE" ]] ; then
	detect_access_mode
    fi

    validate_required_templates
    apply_default_cloudinit_if_needed

    # Calculate VMs per namespace
    VMS_PER_NAMESPACE=$((NUM_VMS / NUM_NAMESPACES))
    REMAINDER_VMS=$((NUM_VMS % NUM_NAMESPACES))

    cat <<EOF
Creating resources for:
  Batch ID: $BATCH_ID
  Total VMs: $NUM_VMS
  Namespaces: $NUM_NAMESPACES
  VMs per namespace: $VMS_PER_NAMESPACE
  Extra VMs in first $REMAINDER_VMS namespaces: $((REMAINDER_VMS > 0 ? 1 : 0))
  Disk source: ${DATASOURCE:+DataSource $DATASOURCE ($DATASOURCE_NS)}${DV_URL:+URL $DV_URL}${CONTAINERDISK_IMAGE:+ContainerDisk $CONTAINERDISK_IMAGE}${DV_URL:+
  Storage Size: $STORAGE_SIZE}
  Storage Class: $(if [[ -n "$CONTAINERDISK_IMAGE" ]]; then echo "N/A (container disk)"; else echo "$STORAGE_CLASS"; fi)
  Access Mode: $(if [[ -n "$CONTAINERDISK_IMAGE" ]]; then echo "N/A (container disk)"; else echo "$ACCESS_MODE"; fi)
  Volume Mode: $(if [[ -n "$CONTAINERDISK_IMAGE" ]]; then echo "N/A (container disk)"; else echo "$VOLUME_MODE"; fi)
  Snapshot mode: $(if [[ -n "$CONTAINERDISK_IMAGE" ]]; then echo "N/A (container disk)"; elif ((USE_SNAPSHOT)); then echo "enabled (class: $SNAPSHOT_CLASS)"; elif [[ -n "$DATASOURCE" ]]; then echo "disabled (direct DataSource clone)"; else echo "disabled (direct PVC clone)"; fi)
  VM Basename: ${VM_BASENAME:-"(none)"}
  VM CPU Cores: $VM_CPU_CORES
  VM Memory: $VM_MEMORY
  Cloud-init: ${CLOUDINIT_FILE:-none}
  UDN L2: $(if ((UDN_L2)); then echo "enabled (subnet: $SUBNET)"; else echo "disabled"; fi)
  Service: $(if ((VM_SERVICE)); then local _svc_ports="port $VM_SERVICE_PORT"; if (( VM_SERVICE_TARGET_PORT != VM_SERVICE_PORT )); then _svc_ports="port $VM_SERVICE_PORT -> targetPort $VM_SERVICE_TARGET_PORT"; fi; if [[ "$VM_SERVICE_TYPE" == clusterip ]]; then echo "enabled (ClusterIP, $_svc_ports)"; else echo "enabled (NodePort, $_svc_ports, node ports from $VM_SERVICE_NODEPORT_BASE, auto-incremented per service)"; fi; else echo "disabled"; fi)
  Wait for Running: $(if ((WAIT)); then echo "yes"; else echo "no"; fi)
  Wait for SSH: $(if ((WAIT_SSH)); then echo "yes (${SSH_READY_TIMEOUT}s hard fail)"; else echo "no"; fi)

EOF
}


oc_apply() {
    if ((wet_run)) ; then
	oc apply -f -
    elif ((quiet)) ; then
	local line
	while read -r line ; do : ; done
    else
	if [[ -n "${DRYRUN_FILE:-}" ]] ; then
	    tee -a "$DRYRUN_FILE"
	    echo "---" >> "$DRYRUN_FILE"
	else
	    cat
	fi
    fi
}

# Join non-empty name parts with '-'.
join_name() {
    local out= part
    for part in "$@"; do
	[[ -z "$part" ]] && continue
	if [[ -n "$out" ]]; then
	    out+="-$part"
	else
	    out="$part"
	fi
    done
    printf '%s' "$out"
}

# Replace templated variables in YAML files with their values.
process_template() {
    local file=$1
    local -a sed_args=(
        -e "s/{vm-ns}/$namespace/g"
        -e "s/{vm-id}/${VM_ID:-}/g"
        -e "s/{BATCH_ID}/$BATCH_ID/g"
        -e "s|{DV_URL}|$DV_URL|g"
        -e "s/{DATASOURCE}/${DATASOURCE:-}/g"
        -e "s/{DATASOURCE_NS}/${DATASOURCE_NS:-}/g"
        -e "s/{BASE_PVC_NAME}/$BASE_PVC_NAME/g"
        -e "s/{STORAGE_SIZE}/$STORAGE_SIZE/g"
        -e "s/{STORAGE_CLASS}/$STORAGE_CLASS/g"
        -e "s/{ACCESS_MODE}/$ACCESS_MODE/g"
        -e "s/{VOLUME_MODE}/$VOLUME_MODE/g"
        -e "s/{SNAPSHOT_CLASS}/$SNAPSHOT_CLASS/g"
        -e "s/{VM_CPU_CORES}/$VM_CPU_CORES/g"
        -e "s/{VM_MEMORY}/$VM_MEMORY/g"
        -e "s/{RUN_STRATEGY}/$RUN_STRATEGY/g"
        -e "s|{SUBNET}|$SUBNET|g"
        -e "s|{CONTAINERDISK_IMAGE}|$CONTAINERDISK_IMAGE|g"
        -e "s/{SVC_TYPE}/${SVC_TYPE:-ClusterIP}/g"
        -e "s/{SVC_NAME_SUFFIX}/${SVC_NAME_SUFFIX:-clusterip}/g"
        -e "s/{SVC_PORT}/${VM_SERVICE_PORT}/g"
        -e "s/{SVC_TARGET_PORT}/${VM_SERVICE_TARGET_PORT}/g"
        -e "s/{SSH_NODEPORT_LINE}/${SSH_NODEPORT_LINE:-}/g"
    )
    # Empty default basename: strip "{VM_BASENAME}-" so resource names
    # become {BATCH_ID}-{id}, base, cloudinit, etc. Bare "{VM_BASENAME}"
    # (labels/selectors) falls back to BATCH_ID so domain matching still works.
    if [[ -n "$VM_BASENAME" ]]; then
	sed_args+=(-e "s/{VM_BASENAME}/$VM_BASENAME/g")
    else
	sed_args+=(-e "s/{VM_BASENAME}-//g" -e "s/{VM_BASENAME}/$BATCH_ID/g")
    fi

    sed "${sed_args[@]}" "$file"
}

# Indent replacement text based on indentation of
# a templated token.  Purpose is to allow indentation of
# YAML fragments based on indentation of the template
# in the text stream.
indent_token() {
    local token=$1
    local text=$2
    local line
    while IFS='' read -r line ; do
	if [[ $line =~ ^([ ]+)\{$token\}$ ]] ; then
	    local prefix=${BASH_REMATCH[1]}
	    while IFS='' read -r repl ; do
		if [[ -n "$repl" ]] ; then
		    echo "${prefix}${repl}"
		fi
	    done <<< "$text"
	else
	    echo "$line"
	fi
    done
}

################################################################
# Function to create namespaces
create_namespaces() {
    local -i ns_start="${1:-1}" ns_end="${2:-$NUM_NAMESPACES}"
    log_message "${C_BOLD}Creating namespaces...${C_RST}"
    local -i ns
    local ns_file="${TEMPLATE_CACHE[namespace]}"
    local udn_label=
    local -A existing_namespaces=()
    if ((UDN_L2)); then
	udn_label='k8s.ovn.org/primary-user-defined-network: ""'
    fi
    if ((wet_run)) ; then
	local namespace
	while read -r namespace ; do
	    if [[ -n "$namespace" ]] ; then existing_namespaces["$namespace"]=1; fi
	done <<< "$(oc get namespace --no-headers 2>/dev/null | awk '{print $1}')"
    fi
    for ((ns=ns_start; ns<=ns_end; ns++)); do
        namespace="${BATCH_ID}-ns-${ns}"

        # Check if namespace already exists
		if [[ -n "${existing_namespaces[$namespace]:-}" ]] ; then
			if ((UDN_L2)); then
				fatal "Namespace ${C_VAL}$namespace${C_RST} already exists, UDN label cannot be applied."
			else
				log_message "Namespace ${C_VAL}$namespace${C_RST} already exists, skipping creation"
			fi
        else
            log_message "Creating namespace: ${C_VAL}$namespace${C_RST}"
            process_template "$ns_file" |
			indent_token UDN_LABEL "$udn_label" |
			oc_apply
			if ((UDN_L2)); then
				create_udn_l2 "$namespace"
			fi
		fi
    done
}

################################################################
# UDN L2
create_udn_l2() {
	local namespace=$1
	log_message "Creating UDN L2 in namespace: ${C_VAL}$namespace${C_RST}"
    local udn_l2_file="${TEMPLATE_CACHE[udn-l2]}"
    process_template "$udn_l2_file" | indent_token NAMESPACE "$namespace" |
	oc_apply
}

init_service_nodeport_next() {
    VM_SERVICE_NODEPORT_NEXT=$VM_SERVICE_NODEPORT_BASE
    if ((wet_run)); then
	local -i max_port=0
	local port
	while read -r port; do
	    if [[ "$port" =~ ^[0-9]+$ ]] && (( port >= VM_SERVICE_NODEPORT_BASE && port <= 32767 )); then
		if (( port > max_port )); then max_port=$port; fi
	    fi
	done < <(oc get svc -A -o jsonpath='{range .items[*]}{.spec.ports[*].nodePort}{"\n"}{end}' 2>/dev/null || true)
	if (( max_port >= VM_SERVICE_NODEPORT_BASE )); then
	    VM_SERVICE_NODEPORT_NEXT=$((max_port + 1))
	fi
    fi
    if (( VM_SERVICE_NODEPORT_NEXT > 32767 )); then
	fatal "No free NodePort available in range ${VM_SERVICE_NODEPORT_BASE}-32767"
    fi
}

next_service_nodeport() {
    if (( VM_SERVICE_NODEPORT_NEXT > 32767 )); then
	fatal "No free NodePort available in range ${VM_SERVICE_NODEPORT_BASE}-32767"
    fi
    SSH_NODEPORT=$VM_SERVICE_NODEPORT_NEXT
    VM_SERVICE_NODEPORT_NEXT=$((VM_SERVICE_NODEPORT_NEXT + 1))
}

create_vm_service() {
    local -i ns_start="${1:-1}" ns_end="${2:-$NUM_NAMESPACES}"
    local svc_file="${TEMPLATE_CACHE[vm-service]}"
    local -i ns
    local svc_name node_port_info
    if ((ns_start == 1)); then
	VM_SERVICE_INFO=()
	if [[ "$VM_SERVICE_TYPE" == nodeport ]]; then
	    init_service_nodeport_next
	fi
    fi
    for ((ns=ns_start; ns<=ns_end; ns++)); do
	namespace="${BATCH_ID}-ns-${ns}"
	if [[ "$VM_SERVICE_TYPE" == nodeport ]]; then
	    SVC_TYPE=NodePort
	    SVC_NAME_SUFFIX=nodeport
	    next_service_nodeport
	    SSH_NODEPORT_LINE="    nodePort: $SSH_NODEPORT"
	    node_port_info=$SSH_NODEPORT
	    svc_name="svc-nodeport-$(join_name "$VM_BASENAME" "$BATCH_ID")"
	    if (( VM_SERVICE_TARGET_PORT != VM_SERVICE_PORT )); then
		log_message "Creating NodePort Service ${C_VAL}$svc_name${C_RST} on nodePort ${C_VAL}$SSH_NODEPORT${C_RST} (port ${C_VAL}$VM_SERVICE_PORT${C_RST} -> targetPort ${C_VAL}$VM_SERVICE_TARGET_PORT${C_RST}) for VMs in namespace: ${C_VAL}$namespace${C_RST}"
	    else
		log_message "Creating NodePort Service ${C_VAL}$svc_name${C_RST} on nodePort ${C_VAL}$SSH_NODEPORT${C_RST} (port ${C_VAL}$VM_SERVICE_PORT${C_RST}) for VMs in namespace: ${C_VAL}$namespace${C_RST}"
	    fi
	else
	    SVC_TYPE=ClusterIP
	    SVC_NAME_SUFFIX=clusterip
	    SSH_NODEPORT_LINE=
	    node_port_info=
	    svc_name="svc-clusterip-$(join_name "$VM_BASENAME" "$BATCH_ID")"
	    if (( VM_SERVICE_TARGET_PORT != VM_SERVICE_PORT )); then
		log_message "Creating ClusterIP Service ${C_VAL}$svc_name${C_RST} (port ${C_VAL}$VM_SERVICE_PORT${C_RST} -> targetPort ${C_VAL}$VM_SERVICE_TARGET_PORT${C_RST}) for VMs in namespace: ${C_VAL}$namespace${C_RST}"
	    else
		log_message "Creating ClusterIP Service ${C_VAL}$svc_name${C_RST} (port ${C_VAL}$VM_SERVICE_PORT${C_RST}) for VMs in namespace: ${C_VAL}$namespace${C_RST}"
	    fi
	fi
	process_template "$svc_file" | oc_apply
	VM_SERVICE_INFO+=("${namespace}:${VM_SERVICE_TYPE}:${node_port_info}:${VM_SERVICE_PORT}:${VM_SERVICE_TARGET_PORT}")
    done
}
################################################################
# DataVolumes
check_datavolume_status() {
    local namespace=$1
    local datavolume_name
    datavolume_name="$(join_name "$VM_BASENAME" "base")"

    log_message "Checking DataVolume status in namespace: ${C_VAL}$namespace${C_RST}"

    # Wait for DataVolume to be completed
    while :; do
	local status
        status=$(oc get datavolume "$datavolume_name" -n "$namespace" -o jsonpath='{.status.phase}' 2>/dev/null || echo "Pending")

        case $status in
            "Succeeded")
                log_message "DataVolume ${C_VAL}$datavolume_name${C_RST} in namespace ${C_VAL}$namespace${C_RST} is completed"
                return 0
                ;;
            "Failed")
                fatal "DataVolume ${C_VAL}$datavolume_name${C_RST} in namespace ${C_VAL}$namespace${C_RST} failed"
                ;;
            "Pending"|"PendingPopulation"|"Running"|"ImportScheduled"|"ImportInProgress"|"CloneScheduled"|"CloneInProgress"|"SnapshotForSmartCloneInProgress"|"SmartClonePVCInProgress")
                log_message "DataVolume ${C_VAL}$datavolume_name${C_RST} in namespace ${C_VAL}$namespace${C_RST} is still ${C_WARN}$status${C_RST}, waiting..."
                sleep 10
                ;;
            *)
                log_message "DataVolume ${C_VAL}$datavolume_name${C_RST} in namespace ${C_VAL}$namespace${C_RST} status: ${C_WARN}$status${C_RST}"
                sleep 10
                ;;
        esac
    done
}

# Function to wait for all DataVolumes to complete
wait_for_all_datavolumes() {
    local -i ns_start="${1:-1}" ns_end="${2:-$NUM_NAMESPACES}"
    log_message "${C_BOLD}Waiting for all DataVolumes to complete...${C_RST}"

    local -i ns
    for ((ns=ns_start; ns<=ns_end; ns++)); do
        namespace="${BATCH_ID}-ns-${ns}"

        if ! check_datavolume_status "$namespace"; then
            fatal "Failed to create DataVolume in namespace ${C_VAL}$namespace${C_RST}"
        fi
    done

    log_message "${C_OK}All DataVolumes are completed successfully!${C_RST}"
}

# Wait for per-VM / data-disk DataVolumes before timestamp collect.
# Base DVs are already waited during create_datavolumes; blank data DVs and
# snapshot-clone DVs appear only after VM apply. Without --wait, create used to
# collect immediately and leave data_dv_ready / data_pvc_bound empty in CSV.
#
# At large scale this wait can take a long time, so — when RESULT_SERVER_URL
# is configured — vstorm also POSTs incremental "progress" manifests as the
# pending DV count changes (throttled by MANIFEST_PROGRESS_INTERVAL, default
# 60s), instead of leaving the collector/dashboard blind until this returns.
# The caller still does a final collect + POST after this returns.
wait_for_batch_datavolumes_for_timestamps() {
    DV_WAIT_TIMED_OUT=0
    if [[ -z "$(type -t oc)" ]] || [[ -z "$(type -t python3)" ]]; then
	return 0
    fi
    # Containerdisk with no blank data disk: no extra DVs to wait on.
    if [[ -n "$CONTAINERDISK_IMAGE" && -z "$DATA_DISK_SIZE" ]]; then
	return 0
    fi

    local ns_json='[]'
    if ((NUM_NAMESPACES > 0)); then
	ns_json=$(BID="$BATCH_ID" N="$NUM_NAMESPACES" python3 -c 'import json,os; bid=os.environ["BID"]; n=int(os.environ["N"]); print(json.dumps([f"{bid}-ns-{i}" for i in range(1,n+1)]))' 2>/dev/null || echo '[]')
    fi

    local -i progress_interval="${MANIFEST_PROGRESS_INTERVAL:-60}"
    local -i progress_enabled=0
    _result_server_url_configured && progress_enabled=1
    local -i last_progress_post=-1000000 last_progress_pending=-1

    log_message "${C_BOLD}Waiting for batch DataVolumes to Succeed (timestamp collect)...${C_RST}"
    local -i deadline=$((SECONDS + 1800))
    local pending_msg="" pending_n=0
    while (( SECONDS < deadline )); do
	pending_msg=$(
	    BID="$BATCH_ID" NS_JSON="$ns_json" python3 - <<'PY'
import json, os, subprocess

batch_id = (os.environ.get("BID") or "").strip()
try:
    ns_set = set(json.loads(os.environ.get("NS_JSON") or "[]"))
except json.JSONDecodeError:
    ns_set = set()

try:
    raw = subprocess.check_output(
        ["oc", "get", "datavolume", "-A", "-o", "json"],
        stderr=subprocess.DEVNULL,
        text=True,
    )
    doc = json.loads(raw) if raw.strip() else {}
except Exception:
    print("oc-error")
    raise SystemExit(0)

pending = []
for it in doc.get("items") or []:
    md = it.get("metadata") or {}
    name = md.get("name") or ""
    ns = md.get("namespace") or ""
    labels = md.get("labels") or {}
    if not name:
        continue
    in_batch = (batch_id and str(labels.get("batch-id") or "") == batch_id) or (ns in ns_set)
    if not in_batch:
        continue
    phase = str(((it.get("status") or {}).get("phase") or "") or "Pending")
    ready = False
    bound = False
    for c in ((it.get("status") or {}).get("conditions") or []):
        if not isinstance(c, dict):
            continue
        if c.get("type") == "Ready" and c.get("status") == "True":
            ready = True
        if c.get("type") == "Bound" and c.get("status") == "True":
            bound = True
    if phase == "Failed":
        pending.append(f"{ns}/{name}:Failed")
    elif phase != "Succeeded" and not (ready and bound):
        pending.append(f"{ns}/{name}:{phase or 'Pending'}")

if not pending:
    print("0")
else:
    print(f"{len(pending)}:{','.join(pending[:5])}")
PY
	)
	if [[ "$pending_msg" == "0" ]]; then
	    log_message "${C_OK}Batch DataVolumes Succeeded (Ready/Bound) — collecting timestamps${C_RST}"
	    return 0
	fi
	if [[ "$pending_msg" == "oc-error" ]]; then
	    log_message "${C_WARN}Could not list DataVolumes; collecting timestamps without wait${C_RST}"
	    return 0
	fi
	pending_n=${pending_msg%%:*}
	log_message "Waiting for ${C_VAL}${pending_n}${C_RST} DataVolume(s): ${C_WARN}${pending_msg#*:}${C_RST}"
	if ((progress_enabled)) && ((pending_n != last_progress_pending)) \
	    && ((SECONDS - last_progress_post >= progress_interval)); then
	    local dv_created_json
	    dv_created_json=$(collect_batch_dv_created_json)
	    BATCH_DV_CREATED_JSON="$dv_created_json"
	    post_batch_result_metadata progress
	    last_progress_post=$SECONDS
	    last_progress_pending=$pending_n
	fi
	sleep 5
    done
    log_message "${C_WARN}Timed out waiting for DataVolumes; collecting timestamps anyway${C_RST}"
    DV_WAIT_TIMED_OUT=1
    return 0
}

create_datavolumes() {
    local -i ns_start="${1:-1}" ns_end="${2:-$NUM_NAMESPACES}"
    # In no-snapshot mode with a DataSource, each VM's DataVolumeTemplate
    # clones directly from the DataSource -- no intermediate base DV needed.
    if [[ -n "$DATASOURCE" ]] && ! ((USE_SNAPSHOT)) ; then
	log_message "Skipping base DataVolume creation (each VM clones directly from DataSource)"
	return
    fi

    log_message "${C_BOLD}Creating DataVolumes...${C_RST}"
    local -i ns
    local dv_file="${TEMPLATE_CACHE[dv]}"
    for ((ns=ns_start; ns<=ns_end; ns++)); do
        namespace="${BATCH_ID}-ns-${ns}"

        log_message "Creating DataVolume for namespace: ${C_VAL}$namespace${C_RST}"
        process_template "$dv_file" | oc_apply
    done
    if ((wet_run)) ; then
	if ((WAIT_FOR_FIRST_CONSUMER)) ; then
	    log_message "Skipping DataVolume wait (${C_VAL}WaitForFirstConsumer${C_RST}); VMs will trigger PVC binding."
	else
	    wait_for_all_datavolumes "$ns_start" "$ns_end"
	fi
    fi
}

################################################################
# VolumeSnapshots
check_volumesnapshot_status() {
    local namespace=$1
    local snapshot_name
    snapshot_name="$(join_name "$VM_BASENAME" "$namespace")"

    log_message "Checking VolumeSnapshot status in namespace: ${C_VAL}$namespace${C_RST}"

    # Wait for VolumeSnapshot to be ready
    while :; do
	local status
        status=$(oc get volumesnapshot "$snapshot_name" -n "$namespace" -o jsonpath='{.status.readyToUse}' 2>/dev/null || echo "false")

	case "$status" in
	    "true")
		log_message "VolumeSnapshot ${C_VAL}$snapshot_name${C_RST} in namespace ${C_VAL}$namespace${C_RST} is ready"
		return 0
		;;
	    *)
		log_message "VolumeSnapshot ${C_VAL}$snapshot_name${C_RST} in namespace ${C_VAL}$namespace${C_RST} is not ready yet, waiting..."
		sleep 10
		;;
	esac
    done
}

# Function to wait for all VolumeSnapshots to be ready
wait_for_all_volumesnapshots() {
    local -i ns_start="${1:-1}" ns_end="${2:-$NUM_NAMESPACES}"
    log_message "${C_BOLD}Waiting for all VolumeSnapshots to be ready...${C_RST}"

    local -i ns
    for ((ns=ns_start; ns<=ns_end; ns++)); do
        namespace="${BATCH_ID}-ns-${ns}"

        if ! check_volumesnapshot_status "$namespace"; then
            fatal "Failed to create VolumeSnapshot in namespace ${C_VAL}$namespace${C_RST}"
        fi
    done

    log_message "${C_OK}All VolumeSnapshots are ready successfully!${C_RST}"
}

create_volumesnapshots() {
    local -i ns_start="${1:-1}" ns_end="${2:-$NUM_NAMESPACES}"
    log_message "${C_BOLD}Creating VolumeSnapshots...${C_RST}"
    local -i ns
    local vs_file="${TEMPLATE_CACHE[volumesnapshot]}"
    for ((ns=ns_start; ns<=ns_end; ns++)); do
        namespace="${BATCH_ID}-ns-${ns}"
        log_message "Creating VolumeSnapshot for namespace: ${C_VAL}$namespace${C_RST}"
        process_template "$vs_file" | oc_apply
    done
    if ((wet_run)) ; then wait_for_all_volumesnapshots "$ns_start" "$ns_end"; fi
}

################################################################
# Workload-result collector: POST run manifest (optional)
# Finds RESULT_SERVER_URL in GUEST_ENV_ARR; no-ops if unset.

# Best-effort: DataVolume + PVC creationTimestamps (and DV Ready/completed) for this batch.
# Never fails the create path. DV/PVC lists are scoped to batch namespaces (not label-only),
# because per-VM snapshot clone DVs and CDI PVCs often lack batch-id labels.
collect_batch_dv_created_json() {
    if [[ -z "$(type -t oc)" ]] || [[ -z "$(type -t python3)" ]]; then
	echo '{}'
	return 0
    fi

    local vm_file ns_file
    vm_file=$(mktemp)
    ns_file=$(mktemp)
    if ((${#BATCH_VMS_ORDERED[@]} > 0)); then
	printf '%s\n' "${BATCH_VMS_ORDERED[@]}" | python3 -c 'import json,sys; print(json.dumps([l.rstrip("\n") for l in sys.stdin if l.strip()]))' > "$vm_file" 2>/dev/null \
	    || printf '%s\n' '[]' > "$vm_file"
    else
	printf '%s\n' '[]' > "$vm_file"
    fi

    if ((NUM_NAMESPACES > 0)); then
	BID="$BATCH_ID" N="$NUM_NAMESPACES" python3 -c 'import json,os; bid=os.environ["BID"]; n=int(os.environ["N"]); print(json.dumps([f"{bid}-ns-{i}" for i in range(1,n+1)]))' > "$ns_file" 2>/dev/null \
	    || printf '%s\n' '[]' > "$ns_file"
    else
	printf '%s\n' '[]' > "$ns_file"
    fi

    # Write cluster-wide DV/PVC JSON to temp files.
    # 1) Avoid Linux MAX_ARG_STRLEN (~128KiB) — large env values cause
    #    "Argument list too long" and a silent {} fallback (empty CSV columns).
    # 2) Avoid bash "${var:-{}}" which parses as default "{" plus a literal "}"
    #    and corrupts JSON with a trailing brace.
    local dv_file pvc_file vs_file py_rc=0 out_json=""
    dv_file=$(mktemp)
    pvc_file=$(mktemp)
    vs_file=$(mktemp)
    if ! oc get datavolume -A -o json > "$dv_file" 2>/dev/null; then
	printf '%s\n' '{}' > "$dv_file"
    fi
    if ! oc get pvc -A -o json > "$pvc_file" 2>/dev/null; then
	printf '%s\n' '{}' > "$pvc_file"
    fi
    if ! oc get volumesnapshot -A -o json > "$vs_file" 2>/dev/null; then
	printf '%s\n' '{}' > "$vs_file"
    fi
    local collector
    collector="$(cd "$(dirname "$0")" && pwd)/monitoring/data-collector/collect_batch_dv_created.py"
    out_json=$(
	BASENAME="$VM_BASENAME" BATCH_ID="$BATCH_ID" \
	VM_JSON_FILE="$vm_file" NS_JSON_FILE="$ns_file" \
	DV_JSON_FILE="$dv_file" PVC_JSON_FILE="$pvc_file" VS_JSON_FILE="$vs_file" \
	python3 "$collector" 2>/dev/null) || py_rc=$?
    rm -f "$dv_file" "$pvc_file" "$vs_file" "$vm_file" "$ns_file"
    if [[ "$py_rc" -ne 0 || -z "$out_json" ]]; then
	echo '{}'
	return 0
    fi
    printf '%s\n' "$out_json"
}

post_batch_result_metadata() {
    # phase: "final" (default; last POST of the run) or "progress" (interim
    # POST while still waiting on DataVolumes at scale — see
    # wait_for_batch_datavolumes_for_timestamps). Both build/POST the full
    # manifest; the collector replaces the previous manifest either way.
    local phase="${1:-final}"
    ensure_default_result_server_url
    local url="" token="" e
    for e in "${GUEST_ENV_ARR[@]+"${GUEST_ENV_ARR[@]}"}"; do
	case "$e" in
	    RESULT_SERVER_URL=*) url="${e#RESULT_SERVER_URL=}" ;;
	    RESULT_SERVER_TOKEN=*) token="${e#RESULT_SERVER_TOKEN=}" ;;
	esac
    done
    [[ -n "$url" ]] || return 0
    if [[ -z "$(type -t curl)" ]]; then
	log_message "${C_WARN}RESULT_SERVER_URL set but curl missing; skip manifest POST${C_RST}"
	return 0
    fi
    if [[ -z "$(type -t python3)" ]]; then
	log_message "${C_WARN}RESULT_SERVER_URL set but python3 missing; skip manifest POST${C_RST}"
	return 0
    fi

    local stopped_at reported_at
    stopped_at=$(date -u +%s)
    reported_at=$stopped_at
    local started_at="${STARTED_AT:-$stopped_at}"

    local ns_json vm_json guest_env_json cmdline_json log_text=""
    local dv_created_json="${BATCH_DV_CREATED_JSON:-}"
    if [[ -z "$dv_created_json" ]]; then
	dv_created_json=$(collect_batch_dv_created_json)
    fi
    # Env must prefix python3 inside $(); bash does not pass VAR=val into ns_json=$(...).
    ns_json=$(BID="$BATCH_ID" NNS="$NUM_NAMESPACES" python3 - <<'PY'
import json, os
bid = os.environ["BID"]
n = int(os.environ["NNS"])
print(json.dumps([f"{bid}-ns-{i}" for i in range(1, n + 1)]))
PY
)

    if ((${#BATCH_VMS_ORDERED[@]} > 0)); then
	vm_json=$(printf '%s\n' "${BATCH_VMS_ORDERED[@]}" | python3 -c 'import json,sys; print(json.dumps([l.rstrip("\n") for l in sys.stdin if l.strip()]))' 2>/dev/null || echo '[]')
    else
	vm_json='[]'
    fi

    if ((${#GUEST_ENV_ARR[@]} > 0)); then
	guest_env_json=$(printf '%s\n' "${GUEST_ENV_ARR[@]}" | python3 -c '
import json, sys
env = {}
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line or "=" not in line:
        continue
    k, _, v = line.partition("=")
    if k == "RESULT_SERVER_TOKEN":
        v = "***"
    env[k] = v
print(json.dumps(env))
')
    else
	guest_env_json='{}'
    fi

    if ((${#VSTORM_ARGV[@]} > 0)); then
	cmdline_json=$(printf '%s\n' "vstorm" "${VSTORM_ARGV[@]}" | python3 -c 'import json,sys; print(json.dumps([l.rstrip("\n") for l in sys.stdin]))')
    else
	cmdline_json='["vstorm"]'
    fi

    if [[ -n "${LOG_FILE:-}" && -f "$LOG_FILE" ]]; then
	log_text=$(python3 -c 'import pathlib,sys; p=pathlib.Path(sys.argv[1]); t=p.read_text(encoding="utf-8", errors="replace"); print(t[:65536])' "$LOG_FILE" 2>/dev/null || true)
    fi

    # Cluster identity (best-effort; never fail the create path).
    local api_server="" oc_version_text="" worker_nodes="" master_nodes=""
    api_server=$(oc config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null || true)
    oc_version_text=$(oc version 2>/dev/null || true)
    worker_nodes=$(oc get nodes -l node-role.kubernetes.io/worker --no-headers 2>/dev/null | wc -l | tr -d '[:space:]')
    master_nodes=$(oc get nodes -l node-role.kubernetes.io/master --no-headers 2>/dev/null | wc -l | tr -d '[:space:]')
    # Newer clusters may label control-plane without master; take the larger count.
    local control_plane_nodes=""
    control_plane_nodes=$(oc get nodes -l node-role.kubernetes.io/control-plane --no-headers 2>/dev/null | wc -l | tr -d '[:space:]')
    if [[ "$control_plane_nodes" =~ ^[0-9]+$ && "$master_nodes" =~ ^[0-9]+$ ]]; then
	if (( control_plane_nodes > master_nodes )); then
	    master_nodes=$control_plane_nodes
	fi
    elif [[ "$control_plane_nodes" =~ ^[0-9]+$ ]]; then
	master_nodes=$control_plane_nodes
    fi
    [[ "$worker_nodes" =~ ^[0-9]+$ ]] || worker_nodes=""
    [[ "$master_nodes" =~ ^[0-9]+$ ]] || master_nodes=""

    # Large JSON must not go through the environment (Linux MAX_ARG_STRLEN
    # ~128KiB) — 2k VMs easily blows DV_CREATED_JSON / VM_JSON / SSH_JSON.
    local payload_file ns_file vm_file guest_env_file cmdline_file
    local dv_file ssh_file log_file_tmp=""
    if [[ -n "${LOG_DIR:-}" ]]; then
	mkdir -p "$LOG_DIR"
	payload_file="${LOG_DIR}/batch-${BATCH_ID}.manifest.json"
    else
	payload_file=$(mktemp)
    fi
    ns_file=$(mktemp)
    vm_file=$(mktemp)
    guest_env_file=$(mktemp)
    cmdline_file=$(mktemp)
    dv_file=$(mktemp)
    ssh_file=$(mktemp)
    printf '%s\n' "$ns_json" > "$ns_file"
    printf '%s\n' "$vm_json" > "$vm_file"
    printf '%s\n' "$guest_env_json" > "$guest_env_file"
    printf '%s\n' "$cmdline_json" > "$cmdline_file"
    if [[ -n "$dv_created_json" ]]; then
	printf '%s\n' "$dv_created_json" > "$dv_file"
    else
	printf '%s\n' '{}' > "$dv_file"
    fi
    if [[ -n "${BATCH_SSH_JSON:-}" ]]; then
	printf '%s\n' "$BATCH_SSH_JSON" > "$ssh_file"
    else
	printf '%s\n' '{}' > "$ssh_file"
    fi
    if [[ -n "$log_text" ]]; then
	log_file_tmp=$(mktemp)
	printf '%s' "$log_text" > "$log_file_tmp"
    fi

    if BATCH_ID="$BATCH_ID" \
	BASENAME="$VM_BASENAME" \
	TOTAL_VMS="$NUM_VMS" \
	TOTAL_NS="$NUM_NAMESPACES" \
	CORES="$VM_CPU_CORES" \
	MEMORY="$VM_MEMORY" \
	CLOUDINIT="${CLOUDINIT_FILE:-}" \
	STORAGE_CLASS="$STORAGE_CLASS" \
	VOLUME_MODE="$VOLUME_MODE" \
	LOG_PATH="${LOG_FILE:-}" \
	STARTED_AT="$started_at" \
	STOPPED_AT="$stopped_at" \
	REPORTED_AT="$reported_at" \
	MANIFEST_PHASE="$phase" \
	DV_WAIT_TIMED_OUT="${DV_WAIT_TIMED_OUT:-0}" \
	API_SERVER="$api_server" \
	OC_VERSION="$oc_version_text" \
	WORKER_NODES="$worker_nodes" \
	MASTER_NODES="$master_nodes" \
	NS_JSON_FILE="$ns_file" \
	VM_JSON_FILE="$vm_file" \
	GUEST_ENV_JSON_FILE="$guest_env_file" \
	CMDLINE_JSON_FILE="$cmdline_file" \
	DV_CREATED_JSON_FILE="$dv_file" \
	SSH_JSON_FILE="$ssh_file" \
	LOG_TEXT_FILE="${log_file_tmp:-}" \
	PAYLOAD_OUT="$payload_file" \
	python3 - <<'PY'
import json, os
from datetime import datetime, timezone
from pathlib import Path

def fmt_utc(unix):
    return datetime.fromtimestamp(int(unix), tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def opt_int(key):
    raw = (os.environ.get(key) or "").strip()
    return int(raw) if raw.isdigit() else None

def load_json_file(key, default):
    path = (os.environ.get(key) or "").strip()
    if not path:
        return default
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return default

cluster = {
    "api_server": (os.environ.get("API_SERVER") or "").strip() or None,
    "oc_version": (os.environ.get("OC_VERSION") or "").rstrip("\n") or None,
    "worker_nodes": opt_int("WORKER_NODES"),
    "master_nodes": opt_int("MASTER_NODES"),
}

payload = {
    "schema_version": 1,
    "record_type": "manifest",
    "source": "vstorm",
    "manifest_phase": os.environ.get("MANIFEST_PHASE") or "final",
    "dv_wait_timed_out": (os.environ.get("DV_WAIT_TIMED_OUT") or "0") == "1",
    "reported_at": fmt_utc(os.environ["REPORTED_AT"]),
    "started_at": fmt_utc(os.environ["STARTED_AT"]),
    "stopped_at": fmt_utc(os.environ["STOPPED_AT"]),
    "batch_id": os.environ["BATCH_ID"],
    "basename": os.environ["BASENAME"],
    "total_vms": int(os.environ["TOTAL_VMS"]),
    "total_namespaces": int(os.environ["TOTAL_NS"]),
    "namespaces": load_json_file("NS_JSON_FILE", []),
    "vms": load_json_file("VM_JSON_FILE", []),
    "cores": int(os.environ["CORES"]) if str(os.environ.get("CORES", "")).isdigit() else os.environ.get("CORES"),
    "memory": os.environ["MEMORY"],
