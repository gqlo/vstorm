    cat <<EOF
Usage: $0 [options] [number_of_vms (default $NUM_VMS) [number_of_namespaces (default $NUM_NAMESPACES)]]
    options:
        -n                      Show what commands would be run
                                without running them
        -q                      Only list objects to be created
        --datasource=NAME       Clone from OCP DataSource (overrides default URL)
        --dv-url=URL            Import disk from URL (default: $DV_URL)
        --storage-size=N        Root / OS disk size ($STORAGE_SIZE)
        --data-disk-size=N      Blank data disk as vdb (opt-in; e.g. 20G; 0=none)
        --storage-class=class   Storage class ($STORAGE_CLASS)
