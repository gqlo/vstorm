	batch_end=$((batch_start + parallel))
	((batch_end > total)) && batch_end=$total
	pids=()
	for ((batch_idx=batch_start; batch_idx<batch_end; batch_idx++)); do
	    virtctl stop "${name_arr[$batch_idx]}" -n "${ns_arr[$batch_idx]}" >/dev/null 2>&1 &
