################################################################
# VMs
wait_for_all_vms() {
    log_message "${C_BOLD}Waiting for all VMs to be ready${C_RST}"
    local -i total_vms="${#expected_vms[@]}"
    local -i ready_vms=0

    while : ; do
	# We expect to have a lot more VMs than we do other objects, which are
	# have only one per namespace.  Therefore the algorithm of waiting in turn for
	# each one to be ready will be inefficient, and we use the method of listing
	# all VMs that are ready and checking them off our list.
	while read -r vm ; do
	    if [[ -n "$vm" && -n "${expected_vms[$vm]:-}" ]] ; then
		unset "expected_vms[$vm]"
		ready_vms=$((ready_vms + 1))
	    fi
	done <<< "$(oc get vm -A --no-headers | awk '{if ($5 == "True" && $4 == "Running") {printf "%s/%s\n", $1, $2}}')"
	if (("${#expected_vms[@]}" == 0)) ; then
	    log_message "${C_OK}All VMs are ready${C_RST}"
	    return
	else
	    log_message "${C_VAL}${ready_vms}${C_RST}/${C_VAL}${total_vms}${C_RST} ready"
	    sleep 60
	fi
    done
}

create_virtualmachines() {
    local -i ns_start="${1:-1}" ns_end="${2:-$NUM_NAMESPACES}" force_wait="${3:-0}"
    # NOTE: ns is deliberately "local -i" (only ever holds a namespace index),
    # but vm must stay a plain (non-integer) local: wait_for_all_vms(), called
    # from below, reuses this same variable name via bash's dynamic scoping
    # (it has no "local vm" of its own) and assigns it "namespace/vm-name"
    # strings. If vm had the -i attribute, that string assignment would be
    # evaluated as arithmetic and blow up under `set -u` on the first
    # non-numeric token (e.g. "vstorm: unbound variable").
    local -i ns
    local vm
    log_message "${C_BOLD}Creating VirtualMachines...${C_RST}"
    # One-time template setup (cloud-init, data disk, existing VM lookup, ...).
    # Guarded so repeated calls -- one per --ns-sequential-creation namespace -- reuse it
    # instead of recomputing/re-listing (e.g. `oc get vm -A`) every time.
    if ((! VM_TEMPLATES_READY)) ; then
    VM_ID=1
	if ((UDN_L2)); then
		vm_file="${TEMPLATE_CACHE[vm-udn]}"
	else
		vm_file="${TEMPLATE_CACHE[vm]}"
	fi
    # Default profile when --cloudinit omitted (SSH + boot timestamp; no workload).
    apply_default_cloudinit_if_needed
    requeststr=
    local -A requests=()
    if [[ -n "${VM_CPU_REQUEST:-}" ]] ; then requests[cpu]=$VM_CPU_REQUEST; fi
    if [[ -n "${VM_MEMORY_REQUEST:-}" ]] ; then requests[memory]=$VM_MEMORY_REQUEST; fi
    if [[ -n "${requests[*]}" ]] ; then
	requeststr="
resources:
  requests:
$(local resource; for resource in "${!requests[@]}" ; do echo "    $resource: ${requests[$resource]}" ; done)
"
    fi
    # Build cloud-init YAML fragments if a cloud-init file is specified.
    # Userdata is stored in a Secret per namespace (to avoid the 2048-byte
    # inline limit) and referenced via userDataSecretRef.
    cloudinit_disk=""
    cloudinit_volume=""
    cloudinit_b64=""
    cloudinit_secret_file=""
    data_dv_templates=""
    data_dv_template=""
    data_disk=""
    data_volume=""
    domain_firmware=
    case "${VM_FIRMWARE,,}" in
	efi)
	    domain_firmware="features:
  smm:
    enabled: true
firmware:
  bootloader:
    efi:
      secureBoot: false"
	    ;;
	bios)
	    domain_firmware="firmware:
  bootloader:
    bios: {}"
	    ;;
	*)
	    fatal "Invalid VM_FIRMWARE='$VM_FIRMWARE' (expected bios or efi)"
	    ;;
    esac

    if [[ -n "$CLOUDINIT_FILE" ]] ; then
	cloudinit_content=$(cat "$CLOUDINIT_FILE")
	_guest_env_branch=false
	if [[ "$cloudinit_content" == *"{VSTORM_GUEST_ENV}"* ]]; then
	    _guest_env_branch=true
	    # Count user --env before auto-inject so we can keep the “no --env” marker.
	    local -i _user_env_count=${#GUEST_ENV_ARR[@]}
	    # Always inject batch id for result sync / policy poll (no-op if already set).
	    local -i _has_vstorm_batch=0
	    local _ge
	    for _ge in "${GUEST_ENV_ARR[@]+"${GUEST_ENV_ARR[@]}"}"; do
		if [[ "$_ge" == VSTORM_BATCH_ID=* ]]; then
		    _has_vstorm_batch=1
		    break
		fi
	    done
	    if ((_has_vstorm_batch == 0)); then
		GUEST_ENV_ARR+=("VSTORM_BATCH_ID=${BATCH_ID}")
	    fi
	    # Lab collector URL unless user set/cleared RESULT_SERVER_URL via --env.
	    ensure_default_result_server_url
	    # Replace entire line containing placeholder so indentation is uniform (6 spaces per line).
	    # Use bash while-read to avoid awk multi-line replacement duplicating or corrupting lines.
	    if [[ "${#GUEST_ENV_ARR[@]}" -gt 0 ]]; then
		GUEST_ENV_LINES=$(printf '%s\n' "${GUEST_ENV_ARR[@]}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed 's/^/      /')
		if ((_user_env_count == 0)); then
		    GUEST_ENV_LINES="      # no --env passed"$'\n'"$GUEST_ENV_LINES"
		fi
	    else
		GUEST_ENV_LINES="      # no --env passed"
	    fi
	    _ci_tmp=$(cat "$CLOUDINIT_FILE")
	    cloudinit_content=""
	    while IFS= read -r line || [[ -n "$line" ]]; do
		if [[ "$line" =~ ^[[:space:]]*\{VSTORM_GUEST_ENV\}[[:space:]]*$ ]]; then
		    cloudinit_content+="$GUEST_ENV_LINES"$'\n'
		else
		    cloudinit_content+="$line"$'\n'
		fi
	    done <<< "$_ci_tmp"
	    cloudinit_content="${cloudinit_content%$'\n'}"
	fi
	cloudinit_b64=$(printf '%s' "$cloudinit_content" | base64 -w0)
	cloudinit_secret_file="${TEMPLATE_CACHE[cloudinit-secret]:-}"
	if [[ -z "$cloudinit_secret_file" ]]; then
	    cloudinit_secret_file=$(_require_builtin cloudinit-secret "$BUILTIN_TEMPLATES_DIR/cloudinit-secret.yaml")
	    TEMPLATE_CACHE[cloudinit-secret]="$cloudinit_secret_file"
	fi
	cloudinit_disk="- disk:
    bus: virtio
  name: cloudinit"
	if ((UDN_L2)); then
	    cloudinit_volume="- cloudInitNoCloud:
    secretRef:
      name: $(join_name "$VM_BASENAME" "cloudinit")
    networkData: |
      version: 2
      ethernets:
        primary-nic: # This is just a label/ID, not the OS device name
          match:
            name: "e*" # Matches eth0, enp1s0, ens3, etc.
          dhcp4: true
  name: cloudinit"
	else
	    cloudinit_volume="- cloudInitNoCloud:
    secretRef:
      name: $(join_name "$VM_BASENAME" "cloudinit")
  name: cloudinit"
	fi
    fi

    if [[ -n "$DATA_DISK_SIZE" ]] ; then
	# Blank data disk (vdb). Name is filled per-VM in the create loop.
	data_disk="- disk:
    bus: virtio
  name: vdb"
	data_volume="- dataVolume:
    name: __DATA_DV_NAME__
  name: vdb"
	data_dv_template="- apiVersion: cdi.kubevirt.io/v1beta1
  kind: DataVolume
  metadata:
    name: __DATA_DV_NAME__
    labels:
      batch-id: \"${BATCH_ID}\"
  spec:
    source:
      blank: {}
    storage:
      accessModes:
      - ${ACCESS_MODE}
      resources:
        requests:
          storage: ${DATA_DISK_SIZE}
      volumeMode: ${VOLUME_MODE}
      storageClassName: ${STORAGE_CLASS}"
	# containerdisk templates have no dataVolumeTemplates section yet
	data_dv_templates="dataVolumeTemplates:
${data_dv_template}"
	log_message "Data disk enabled: ${C_VAL}${DATA_DISK_SIZE}${C_RST} blank volume as ${C_VAL}vdb${C_RST}"
    fi

    if ((! RECREATE_EXISTING_VMS)) ; then
	local vm
	while read -r vm ; do
	    if [[ -n "$vm" ]] ; then existing_vms["$vm"]=1; fi
	done <<< "$(oc get vm -A --no-headers | awk '{printf "%s/%s\n", $1, $2}')"
    fi
    VM_TEMPLATES_READY=1
    fi
    for ((ns=ns_start; ns<=ns_end; ns++)); do
        namespace="${BATCH_ID}-ns-${ns}"

	# Create cloud-init Secret in this namespace if needed
	if [[ -n "$cloudinit_secret_file" ]] ; then
	    log_message "Creating cloud-init Secret in namespace: ${C_VAL}$namespace${C_RST}"
	    process_template "$cloudinit_secret_file" |
		sed "s|{CLOUDINIT_B64}|$cloudinit_b64|g" |
		oc_apply ||
		fatal "Cannot create cloud-init secret in $namespace!"
	fi

        # Calculate VMs for this namespace
        vms_in_this_namespace=$VMS_PER_NAMESPACE
        if [[ $ns -le $REMAINDER_VMS ]]; then
            vms_in_this_namespace=$((vms_in_this_namespace + 1))
        fi

        # Create VMs for this namespace
        for ((vm=1; vm<=vms_in_this_namespace; vm++)); do
	    local vm_name="${namespace}/$(join_name "$VM_BASENAME" "$BATCH_ID" "$VM_ID")"
	    if [[ -z "${existing_vms[$vm_name]:-}" ]] ; then
		log_message "Creating VirtualMachine ${C_VAL}$VM_ID${C_RST} for namespace: ${C_VAL}$namespace${C_RST}"
		local data_dv_name
		data_dv_name="$(join_name "$VM_BASENAME" "$BATCH_ID" "$VM_ID" "data")"
		local data_dv_templates_vm="" data_dv_template_vm="" data_volume_vm=""
		if [[ -n "$DATA_DISK_SIZE" ]] ; then
		    data_dv_template_vm=${data_dv_template//__DATA_DV_NAME__/$data_dv_name}
		    data_dv_templates_vm=${data_dv_templates//__DATA_DV_NAME__/$data_dv_name}
		    data_volume_vm=${data_volume//__DATA_DV_NAME__/$data_dv_name}
		fi
		process_template "$vm_file" |
		    indent_token DOMAIN_FIRMWARE "$domain_firmware" |
		    indent_token RESOURCES "$requeststr" |
		    indent_token CLOUDINIT_DISK "$cloudinit_disk" |
		    indent_token CLOUDINIT_VOLUME "$cloudinit_volume" |
		    indent_token DATA_DV_TEMPLATES "$data_dv_templates_vm" |
		    indent_token DATA_DV_TEMPLATE "$data_dv_template_vm" |
		    indent_token DATA_DISK "$data_disk" |
		    indent_token DATA_VOLUME "$data_volume_vm" |
		    oc_apply ||
		    fatal "Cannot create vm $vm_name!"
	    fi
	    expected_vms["$vm_name"]=1
	    BATCH_VMS_ORDERED+=("$vm_name")
            VM_ID=$((VM_ID + 1))
        done
    done
    if ((wet_run)) ; then
	if ((WAIT || force_wait)) ; then
	    wait_for_all_vms
	else
	    log_message "Not waiting for all VMs"
	fi
    fi
}

################################################################
# Verify cloud-init completed successfully inside each VM.
# Uses virtctl ssh + sshpass for non-interactive access.
# Polls in rounds (30s apart, up to 5 min) until each VM
# reports "done" or "error".  Gracefully skips if tools
# are missing.
verify_cloudinit() {
    # Collect VMs for this batch from the cluster
    local -a all_vms=()
    local ns vm_name
    while read -r ns vm_name _rest; do
	[[ -n "$vm_name" ]] || continue
	all_vms+=("$ns/$vm_name")
    done <<< "$(oc get vm -A -l batch-id="$BATCH_ID" --no-headers 2>/dev/null | awk '{print $1, $2}')"

    local -i total=${#all_vms[@]}
    if ((total == 0)); then return 0; fi

    # Sample up to 3 random VMs to keep verification fast at any scale
    local -i max_sample=3
    local -A vm_pending=()
    if ((total <= max_sample)); then
	for vm_key in "${all_vms[@]}"; do
	    vm_pending["$vm_key"]=1
	done
    else
	local -A picked=()
	while ((${#picked[@]} < max_sample)); do
	    local idx=$((RANDOM % total))
	    if [[ -z "${picked[$idx]:-}" ]]; then
		picked[$idx]=1
		vm_pending["${all_vms[$idx]}"]=1
	    fi
	done
    fi

    local -i sample=${#vm_pending[@]}
    log_message "Verifying cloud-init on ${C_VAL}$sample${C_RST} of ${C_VAL}$total${C_RST} VM(s) (polling up to 5 minutes)..."

    local -i ok_count=0
    local -i fail_count=0
    local -i round
    local vm_key ci_status

    for ((round=1; round<=10; round++)); do
	((${#vm_pending[@]} > 0)) || break
	if ((round > 1)); then sleep 30; fi

	for vm_key in "${!vm_pending[@]}"; do
	    ns="${vm_key%%/*}"
	    vm_name="${vm_key##*/}"

	    ci_status=$(sshpass -p password virtctl ssh -n "$ns" \
		--local-ssh-opts="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10" \
		root@"$vm_name" --command "cloud-init status" 2>/dev/null) || ci_status=""

	    if [[ "$ci_status" == *"done"* ]]; then
		log_message "  ${C_VAL}$vm_name${C_RST}: cloud-init ${C_OK}OK${C_RST}"
		unset "vm_pending[$vm_key]"
		((ok_count++))
	    elif [[ "$ci_status" == *"error"* ]]; then
		log_message "  ${C_WARN}WARNING:${C_RST} ${C_VAL}$vm_name${C_RST}: cloud-init ${C_ERR}FAILED${C_RST}"
		unset "vm_pending[$vm_key]"
		((fail_count++))
	    fi
	done

	if ((${#vm_pending[@]} > 0)); then
	    log_message "  ${C_VAL}$((ok_count + fail_count))${C_RST}/${C_VAL}${sample}${C_RST} checked, ${C_VAL}${#vm_pending[@]}${C_RST} still running..."
	fi
    done

    # Remaining VMs timed out
    for vm_key in "${!vm_pending[@]}"; do
	vm_name="${vm_key##*/}"
	log_message "  ${C_WARN}WARNING:${C_RST} ${C_VAL}$vm_name${C_RST}: cloud-init verification timed out"
	((fail_count++))
    done

    if ((fail_count > 0)); then
	log_message "Cloud-init: ${C_VAL}$ok_count${C_RST} OK, ${C_ERR}$fail_count${C_RST} FAILED or timed out (sampled ${C_VAL}$sample${C_RST} of ${C_VAL}$total${C_RST})"
	log_message "  Inspect: virtctl ssh -n <ns> root@<vm> -c 'cloud-init status --long'"
    else
	log_message "${C_OK}Cloud-init: $sample of $total VM(s) sampled -- all OK${C_RST}"
    fi
}

################################################################
# Workload-agnostic SSH reachability check.
# Uses virtctl port-forward + nc (no password/key). Each VM has
# SSH_READY_TIMEOUT seconds; any still down => failure.
# Probes run in batches of SSH_PROBE_PARALLEL to avoid fd/PID exhaustion.
# Sets BATCH_SSH_JSON for the host manifest POST (via temp files — not env).
# Returns 0 if all probed VMs are up, 1 otherwise.
verify_ssh_port() {
    BATCH_SSH_JSON=
    local -a vm_keys=("${BATCH_VMS_ORDERED[@]+"${BATCH_VMS_ORDERED[@]}"}")
    local -i total=${#vm_keys[@]}
    if ((total == 0)); then
	log_message "${C_WARN}SSH check: no VMs in batch; skipping${C_RST}"
	return 0
    fi

    if [[ -z "$(type -t virtctl)" ]]; then
	fatal "Error: --wait-ssh requires virtctl (see helpers/install-virtctl)"
    fi
    if [[ -z "$(type -t nc)" ]]; then
	fatal "Error: --wait-ssh requires nc (nmap-ncat / netcat)"
    fi

    local guest_port="${VM_SERVICE_TARGET_PORT:-22}"
    local timeout="${SSH_READY_TIMEOUT:-30}"
    local -i parallel="${SSH_PROBE_PARALLEL:-1000}"
    ((parallel < 1)) && parallel=1
    log_message "${C_BOLD}Checking SSH port ${C_VAL}${guest_port}${C_RST}${C_BOLD} on ${C_VAL}${total}${C_RST}${C_BOLD} VM(s) (timeout ${C_VAL}${timeout}s${C_RST}${C_BOLD} each, ${C_VAL}${parallel}${C_RST}${C_BOLD} parallel)...${C_RST}"

    local tmpdir
    tmpdir=$(mktemp -d)
    # shellcheck disable=SC2064
    trap "rm -rf '$tmpdir'" RETURN

    local ready_tsv="${tmpdir}/ready.tsv"
    local failed_txt="${tmpdir}/failed.txt"
    : > "$ready_tsv"
    : > "$failed_txt"

    local -i ok_count=0 fail_count=0
    local -i log_each=1
    ((total > 100)) && log_each=0

    local -i batch_start=0 batch_end batch_idx slot
    local vm_key ns vm_name local_port out_file
    local -a pids=() probe_vms=()
    local idx pid rc ready_ts

    while ((batch_start < total)); do
	batch_end=$((batch_start + parallel))
	((batch_end > total)) && batch_end=$total
	pids=()
	probe_vms=()

	for ((batch_idx=batch_start; batch_idx<batch_end; batch_idx++)); do
	    vm_key="${vm_keys[$batch_idx]}"
	    ns="${vm_key%%/*}"
	    vm_name="${vm_key##*/}"
	    slot=$((batch_idx - batch_start))
	    local_port=$((23000 + slot))
	    out_file="${tmpdir}/${vm_name}.ready"
	    probe_vms+=("$vm_name")
	    (
		local pf_pid="" deadline now
		deadline=$(($(date +%s) + timeout))
		cleanup_pf() {
		    if [[ -n "${pf_pid:-}" ]]; then
			kill "$pf_pid" 2>/dev/null || true
			wait "$pf_pid" 2>/dev/null || true
		    fi
		}
		trap cleanup_pf EXIT
		virtctl port-forward -n "$ns" "vmi/${vm_name}" "${local_port}:${guest_port}" >/dev/null 2>&1 &
		pf_pid=$!
		while true; do
		    now=$(date +%s)
		    if ((now >= deadline)); then
			exit 1
		    fi
		    if ! kill -0 "$pf_pid" 2>/dev/null; then
			wait "$pf_pid" 2>/dev/null || true
			virtctl port-forward -n "$ns" "vmi/${vm_name}" "${local_port}:${guest_port}" >/dev/null 2>&1 &
			pf_pid=$!
			sleep 1
			continue
		    fi
		    if nc -z -w 1 127.0.0.1 "$local_port" 2>/dev/null; then
			date -u +%Y-%m-%dT%H:%M:%SZ > "$out_file"
			exit 0
		    fi
		    sleep 1
		done
	    ) &
	    pids+=($!)
	done

	for idx in "${!pids[@]}"; do
	    pid=${pids[$idx]}
	    vm_name=${probe_vms[$idx]}
	    rc=0
	    wait "$pid" || rc=$?
	    if ((rc == 0)) && [[ -f "${tmpdir}/${vm_name}.ready" ]]; then
		ready_ts=$(cat "${tmpdir}/${vm_name}.ready")
		printf '%s\t%s\n' "$vm_name" "$ready_ts" >> "$ready_tsv"
		if ((log_each)); then
		    log_message "  ${C_VAL}${vm_name}${C_RST}: SSH port ${C_OK}UP${C_RST} at ${C_VAL}${ready_ts}${C_RST}"
		fi
		ok_count=$((ok_count + 1))
	    else
		printf '%s\n' "$vm_name" >> "$failed_txt"
		log_message "  ${C_WARN}WARNING:${C_RST} ${C_VAL}${vm_name}${C_RST}: SSH port ${C_ERR}DOWN${C_RST} after ${C_VAL}${timeout}s${C_RST}"
		fail_count=$((fail_count + 1))
	    fi
	done

	if ((!log_each)); then
	    log_message "  SSH check progress: ${C_VAL}$((ok_count + fail_count))${C_RST}/${C_VAL}${total}${C_RST} (${C_VAL}${ok_count}${C_RST} UP, ${C_ERR}${fail_count}${C_RST} failed)"
	fi
	batch_start=$batch_end
    done

    # Large JSON must not go through the environment (Linux MAX_ARG_STRLEN ~128KiB).
    local ssh_json_file="${tmpdir}/ssh.json"
    python3 - "$ready_tsv" "$failed_txt" "$guest_port" "$timeout" "$ssh_json_file" <<'PY'
import json, sys
from pathlib import Path

ready_path, failed_path, port, timeout, out_path = sys.argv[1:6]
ready = {}
for line in Path(ready_path).read_text(encoding="utf-8").splitlines():
    if not line or "\t" not in line:
        continue
    k, _, v = line.partition("\t")
    ready[k] = v
failed = [l.strip() for l in Path(failed_path).read_text(encoding="utf-8").splitlines() if l.strip()]
out = {
    "vm_ssh_ready": ready,
    "vm_ssh_failed": failed,
    "ssh_ready_status": "ok" if not failed else "failed",
    "ssh_ready_port": int(port or 22),
    "ssh_ready_timeout_s": int(timeout or 30),
}
if ready and not failed:
    out["ssh_ready_at"] = min(ready.values())
Path(out_path).write_text(json.dumps(out), encoding="utf-8")
PY
    BATCH_SSH_JSON=$(<"$ssh_json_file")

    if ((fail_count > 0)); then
	log_message "SSH check: ${C_VAL}${ok_count}${C_RST} UP, ${C_ERR}${fail_count}${C_RST} FAILED (timeout ${C_VAL}${timeout}s${C_RST})"
	return 1
    fi
    log_message "${C_OK}SSH check: ${ok_count}/${total} VM(s) — all ports UP${C_RST}"
    return 0
}

################################################################
# Fire parallel `virtctl stop` for a VM list ("namespace name" pairs per line).
# Returns 0 if stop requests were sent, 1 if stop was skipped (no virtctl,
# empty list, or no VMs to stop) so callers can skip wait_for_vms_stopped.
# Args: $1 = newline-separated "namespace vm-name" pairs (may be empty)
stop_vms() {
    local vm_list=$1
    [[ -n "$vm_list" ]] || return 1

    if [[ -z "$(type -t virtctl)" ]]; then
	log_message "${C_WARN}virtctl not found; skipping graceful VM stop before delete${C_RST}"
	return 1
    fi

    local -a ns_arr=() name_arr=()
    local ns name
    while read -r ns name ; do
	[[ -n "$ns" && -n "$name" ]] || continue
	ns_arr+=("$ns")
	name_arr+=("$name")
    done <<< "$vm_list"

    local -i total=${#name_arr[@]}
    ((total == 0)) && return 1

    local -i parallel=${STOP_PARALLEL:-200}
    ((parallel < 1)) && parallel=1
    log_message "${C_BOLD}Stopping ${C_VAL}${total}${C_RST}${C_BOLD} VM(s) (virtctl stop, ${C_VAL}${parallel}${C_RST}${C_BOLD} parallel) before delete...${C_RST}"

    local -i batch_start=0 batch_end batch_idx
    local -a pids=()
    while ((batch_start < total)); do
	batch_end=$((batch_start + parallel))
	((batch_end > total)) && batch_end=$total
	pids=()
	for ((batch_idx=batch_start; batch_idx<batch_end; batch_idx++)); do
	    virtctl stop "${name_arr[$batch_idx]}" -n "${ns_arr[$batch_idx]}" >/dev/null 2>&1 &
	    pids+=($!)
	done

	local -i idx pid rc
	for idx in "${!pids[@]}"; do
	    pid=${pids[$idx]}
	    rc=0
	    wait "$pid" || rc=$?
	    if ((rc != 0)); then
		local failed_idx=$((batch_start + idx))
		log_message "  ${C_WARN}WARNING:${C_RST} virtctl stop failed for ${C_VAL}${ns_arr[$failed_idx]}/${name_arr[$failed_idx]}${C_RST} (rc=$rc); continuing"
	    fi
	done
	batch_start=$batch_end
    done
    log_message "${C_OK}Stop requests sent for ${C_VAL}${total}${C_RST} VM(s)${C_RST}"
    return 0
}

################################################################
# Wait for VMs in vm_list to reach "Stopped" after stop_vms().
# Args: $1 = newline-separated "namespace vm-name" pairs
wait_for_vms_stopped() {
    local vm_list=$1
    [[ -n "$vm_list" ]] || return 0

    local -A pending=()
    local ns name
    while read -r ns name ; do
	[[ -n "$ns" && -n "$name" ]] || continue
	pending["${ns}/${name}"]=1
    done <<< "$vm_list"

    local -i total=${#pending[@]}
    ((total == 0)) && return 0

    local -i interval=${DELETE_POLL_INTERVAL:-2}
    local -i timeout=${STOP_WAIT_TIMEOUT:-1800}
    local -i deadline=$((SECONDS + timeout))

    log_message "${C_BOLD}Waiting for ${C_VAL}${total}${C_RST}${C_BOLD} VM(s) to reach Stopped...${C_RST}"

    local vm_ns vm_name status key
    local -i stopped
    while : ; do
	while read -r vm_ns vm_name status ; do
	    [[ -n "$vm_ns" && -n "$vm_name" ]] || continue
	    key="${vm_ns}/${vm_name}"
	    if [[ "$status" == "Stopped" && -n "${pending[$key]:-}" ]] ; then
		unset "pending[$key]"
	    fi
	done <<< "$(oc get vm -A --no-headers 2>/dev/null | awk '{print $1, $2, $4}')"

	stopped=$((total - ${#pending[@]}))
	printf '\r  %s/%s VMs stopped   ' "$stopped" "$total"

	if (( ${#pending[@]} == 0 )) ; then
	    echo ""
	    log_message "${C_OK}All ${C_VAL}${total}${C_RST} VM(s) are Stopped${C_RST}"
	    return 0
	fi

	if (( SECONDS >= deadline )) ; then
	    echo ""
	    log_message "${C_WARN}Timed out after ${timeout}s waiting for VMs to stop (${#pending[@]}/${total} still not Stopped); proceeding with namespace delete anyway${C_RST}"
	    return 1
	fi

	sleep "$interval"
    done
}

################################################################
# Gracefully stop all VMs in a batch (parallel `virtctl stop`) before
# `oc delete ns` tears down their namespaces, instead of letting namespace
# deletion abruptly kill running VMIs. Best-effort: a missing virtctl
# binary, or an individual VM that's already stopped/gone, only logs a
# warning -- it never blocks the delete. Runs in batches of STOP_PARALLEL
# concurrent `virtctl stop` calls (default 200) to avoid PID/fd exhaustion
# on very large batches. Once stop requests are sent, waits (best-effort,
# see wait_for_vms_stopped) for the VMs to actually reach Stopped.
# Args: $1 = batch ID (unused; kept for call-site compatibility),
#        $2 = newline-separated "namespace vm-name" pairs (may be empty)
stop_batch_vms() {
    local vm_list=$2
    if stop_vms "$vm_list"; then
	wait_for_vms_stopped "$vm_list" || true
    fi
}

################################################################
# Wait for all VMs in a batch to actually reach "Stopped" after
# stop_batch_vms() fires parallel `virtctl stop` calls, before namespace
# deletion proceeds. `virtctl stop` only submits the stop request -- the VM
# still needs a few seconds to shut down its VMI -- so this polls
# `oc get vm -A` every DELETE_POLL_INTERVAL (default 2s) until every VM's
# printableStatus is Stopped, or STOP_WAIT_TIMEOUT (default 1800s) is hit.
# Best-effort: on timeout it only warns and returns 1 -- callers proceed
# with `oc delete ns` regardless, which forcibly cleans up whatever is
# still shutting down.
# Args: $1 = batch ID (unused; kept for call-site compatibility),
#        $2 = newline-separated "namespace vm-name" pairs
wait_for_batch_vms_stopped() {
    wait_for_vms_stopped "$2"
}

################################################################
# Poll cluster-scoped storage still tied to a batch's namespaces after
# `oc delete ns --wait=false` returns, refreshing counts every
# DELETE_POLL_INTERVAL (default 2s) until namespaces, PVCs, PVs, and
# VolumeAttachments all reach zero, or DELETE_POLL_TIMEOUT (default 14400s)
# is hit. PVs and VolumeAttachments are cluster-scoped and carry no
# batch-id label, so they are correlated to the batch via the namespace
# naming pattern ({batch}-ns-{N}) instead (PVs via spec.claimRef.namespace,
# VolumeAttachments via spec.source.persistentVolumeName -> that PV).
# Args: $1 = batch ID
watch_batch_delete_cleanup() {
    local batch=$1
    local -i interval=${DELETE_POLL_INTERVAL:-2}
    local -i timeout=${DELETE_POLL_TIMEOUT:-14400}
    local -i deadline=$((SECONDS + timeout))
    local ns_pat="^${batch}-ns-[0-9]+\$"

    log_message "${C_BOLD}Monitoring cleanup for batch ${C_VAL}'$batch'${C_RST} (namespaces, PVCs, PVs, VolumeAttachments; refresh every ${interval}s)...${C_RST}"

    local -i ns_n pvc_n pv_n va_n
    while : ; do
	ns_n=$(oc get ns -l batch-id="$batch" --no-headers 2>/dev/null | wc -l)
	pvc_n=$(oc get pvc -A --no-headers 2>/dev/null | awk -v pat="$ns_pat" '$1 ~ pat {c++} END{print c+0}')

	local pv_names_file
	pv_names_file=$(mktemp)
	oc get pv -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.claimRef.namespace}{"\n"}{end}' 2>/dev/null \
	    | awk -v pat="$ns_pat" '$2 ~ pat {print $1}' > "$pv_names_file"
	pv_n=$(wc -l < "$pv_names_file")

	va_n=$(oc get volumeattachment -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.source.persistentVolumeName}{"\n"}{end}' 2>/dev/null \
	    | awk -v pvf="$pv_names_file" 'BEGIN{while((getline l < pvf) > 0) pv[l]=1} $2 in pv {c++} END{print c+0}')
	rm -f "$pv_names_file"

	printf '\r  namespaces=%-4s PVCs=%-4s PVs=%-4s VolumeAttachments=%-4s   ' \
	    "$ns_n" "$pvc_n" "$pv_n" "$va_n"

	if (( ns_n == 0 && pvc_n == 0 && pv_n == 0 && va_n == 0 )) ; then
	    echo ""
	    log_message "${C_OK}Batch ${C_VAL}'$batch'${C_RST} fully cleaned up${C_RST} (no leftover namespaces, PVCs, PVs, or VolumeAttachments)"
	    return 0
	fi

	if (( SECONDS >= deadline )) ; then
	    echo ""
	    log_message "${C_WARN}Timed out after ${timeout}s waiting for batch ${C_VAL}'$batch'${C_RST} cleanup; leftovers remain: namespaces=$ns_n PVCs=$pvc_n PVs=$pv_n VolumeAttachments=$va_n${C_RST}"
	    return 1
	fi

	sleep "$interval"
    done
}

################################################################
# Return 0 if a namespace must not be deleted by --delete-all.
is_protected_delete_namespace() {
    local ns=$1
    case "$ns" in
	kube-system|kube-public|kube-node-lease|default) return 0 ;;
    esac
    [[ "$ns" == openshift* ]] && return 0
    [[ "$ns" == kube-* ]] && return 0
    return 1
}

################################################################
# List namespaces that contain VirtualMachines (excluding protected system ns).
discover_vm_namespaces() {
    local all_vm_ns ns
    all_vm_ns=$(oc get vm -A --no-headers 2>/dev/null | awk '{print $1}' | sort -u) || true
    [[ -z "$all_vm_ns" ]] && return 0

    while read -r ns ; do
	[[ -z "$ns" ]] && continue
	is_protected_delete_namespace "$ns" && continue
	echo "$ns"
    done <<< "$all_vm_ns"
}

################################################################
# Build "namespace vm-name" lines for VMs in the given namespace list.
# Args: $1 = newline-separated namespace names
discover_vm_list() {
    local vm_ns_list=$1
    local -A ns_set=()
    local ns name

    [[ -z "$vm_ns_list" ]] && return 0
    while read -r ns ; do
	[[ -n "$ns" ]] && ns_set["$ns"]=1
    done <<< "$vm_ns_list"

    while read -r ns name ; do
	[[ -n "$ns" && -n "$name" ]] || continue
	[[ -n "${ns_set[$ns]:-}" ]] || continue
	echo "$ns $name"
    done <<< "$(oc get vm -A --no-headers 2>/dev/null | awk '{print $1, $2}')"
}

################################################################
# Return 0 if a namespace name matches a vstorm batch layout for batch ID.
# Current batches: {batch}-ns-{N}.  Legacy batches used vm-{batch}-ns-{N}
# while batch-id stayed the bare hex ID (e.g. batch-id=4b2d1f,
# namespace=vm-4b2d1f-ns-1).
is_vstorm_batch_namespace() {
    local batch=$1 ns_name=$2
    [[ -n "$batch" && -n "$ns_name" ]] || return 1
    [[ "$ns_name" =~ ^${batch}-ns-[0-9]+$ ]] && return 0
    [[ "$ns_name" =~ ^vm-${batch}-ns-[0-9]+$ ]] && return 0
    return 1
}

################################################################
# Wait for all VMs in a namespace to reach "Stopped" (see wait_for_batch_vms_stopped).
# Args: $1 = namespace, $2 = newline-separated "namespace vm-name" pairs
wait_for_namespace_vms_stopped() {
    local ns=$1
    local vm_list=$2
    [[ -n "$vm_list" ]] || return 0

    local -A pending=()
    local vm_ns name
    while read -r vm_ns name ; do
	[[ -n "$vm_ns" && -n "$name" ]] || continue
	pending["${vm_ns}/${name}"]=1
    done <<< "$vm_list"

    local -i total=${#pending[@]}
    ((total == 0)) && return 0

    local -i interval=${DELETE_POLL_INTERVAL:-2}
    local -i timeout=${STOP_WAIT_TIMEOUT:-1800}
    local -i deadline=$((SECONDS + timeout))

    log_message "${C_BOLD}Waiting for ${C_VAL}${total}${C_RST}${C_BOLD} VM(s) in ${C_VAL}${ns}${C_RST}${C_BOLD} to reach Stopped...${C_RST}"

    local vm_name status key
    local -i stopped
    while : ; do
	while read -r vm_name status ; do
	    [[ -n "$vm_name" ]] || continue
	    key="${ns}/${vm_name}"
	    if [[ "$status" == "Stopped" && -n "${pending[$key]:-}" ]] ; then
		unset "pending[$key]"
	    fi
	done <<< "$(oc get vm -n "$ns" --no-headers 2>/dev/null | awk '{print $1, $3}')"

	stopped=$((total - ${#pending[@]}))
	printf '\r  %s/%s VMs stopped   ' "$stopped" "$total"

	if (( ${#pending[@]} == 0 )) ; then
	    echo ""
	    log_message "${C_OK}All ${C_VAL}${total}${C_RST} VM(s) in ${C_VAL}${ns}${C_RST} are Stopped${C_RST}"
	    return 0
	fi

	if (( SECONDS >= deadline )) ; then
	    echo ""
	    log_message "${C_WARN}Timed out after ${timeout}s waiting for VMs in ${C_VAL}${ns}${C_RST} to stop (${#pending[@]}/${total} still not Stopped); proceeding with namespace delete anyway${C_RST}"
	    return 1
	fi

	sleep "$interval"
    done
}

################################################################
