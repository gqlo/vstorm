#!/bin/bash

# vstorm - Batch VM creation tool for OpenShift Virtualization
# Creates DataVolume, VolumeSnapshot, and VirtualMachine resources
# with unique batch IDs to avoid naming conflicts across runs.
# Usage: vstorm <options> [<total-VMs> [<namespaces>]]

set -eu

# Close inherited file descriptors above stderr.
# Prevents subshell deadlocks when invoked from environments (e.g. git hooks,
# CI runners) that leave extra fds open for lock files or IPC.
for _fd in 3 4 5 6 7 8 9; do
    eval "exec $_fd>&-" 2>/dev/null || true
done

# Configuration variables - modify these as needed
DATASOURCE=
DATASOURCE_NS="openshift-virtualization-os-images"
DV_URL="http://storage.scalelab.redhat.com/lee/vm-images/rhel9-cloud-init.qcow"
STORAGE_SIZE="32Gi"
DATA_DISK_SIZE=""
STORAGE_CLASS="ocs-storagecluster-ceph-rbd-virtualization"
ACCESS_MODE="ReadWriteMany"
VOLUME_MODE="Block"
SNAPSHOT_CLASS="ocs-storagecluster-rbdplugin-snapclass"
USE_SNAPSHOT=1
STORAGE_CLASS_SET=0
ACCESS_MODE_SET=0
VOLUME_MODE_SET=0
WAIT_FOR_FIRST_CONSUMER=0
UDN_L2=0
VM_SERVICE=0
VM_SERVICE_TYPE=nodeport
VM_SERVICE_PORT=22
VM_SERVICE_TARGET_PORT=22
VM_SERVICE_NODEPORT_BASE=32222
VM_SERVICE_NODEPORT_NEXT=
VM_SERVICE_INFO=()
SUBNET="10.132.10.0/16"
SNAPSHOT_CLASS_SET=0
SNAPSHOT_EXPLICITLY_SET=0
BASE_PVC_NAME="base"
VM_BASENAME=""
BASENAME_SET=0
PVC_BASE_NAME_SET=0
VM_CPU_CORES="1"
VM_MEMORY="1Gi"
# Guest firmware: efi (OVMF + SMM; secureBoot false by default) or bios (legacy)
VM_FIRMWARE="efi"
# YAML templates live in templates/ next to this script.
BUILTIN_TEMPLATES_DIR="$(cd "$(dirname "$0")" && pwd)/templates"
VM_CPU_REQUEST=
VM_MEMORY_REQUEST=
CLOUDINIT_FILE=
GUEST_ENV_ARR=()
# Default collector ingest URL when --env RESULT_SERVER_URL=… is omitted.
# Override with --env RESULT_SERVER_URL=…, or disable with --env RESULT_SERVER_URL=
DEFAULT_RESULT_SERVER_URL="http://n42-h01-b02-mx750c.rdu3.labs.perfscale.redhat.com:8080/v1/results"
# Original argv (for manifest cmdline); set before getopts mutates "$@"
VSTORM_ARGV=("$@")
# Epoch when logging/setup starts; filled in setup_logging
STARTED_AT=
# Ordered VM list for this batch (survives wait_for_all_vms unsetting expected_vms)
BATCH_VMS_ORDERED=()
# Auto batch ID: "vstorm-" + 6 hex chars so it always starts with letters (YAML-safe).
# Override with --batch-id=ID.
if [[ -z "$(type -t xxd)" ]] ; then
    echo "Error: xxd command is not installed (needed to generate batch IDs)"
    exit 1
fi
BATCH_ID="vstorm-$(head -c 3 /dev/urandom | xxd -p)"
BATCH_ID_SET=0
NUM_VMS=1
NUM_VMS_PER_NAMESPACE=
NUM_NAMESPACES=1
# 0 (default): create/wait all namespaces together (current behavior).
# 1: fully create + wait one namespace (DVs, snapshots, VMs -> Running)
# before starting the next one.
NS_SEQUENTIAL_CREATION=0
RUN_STRATEGY=Always
WAIT=0
# After VMs are Running, probe guest SSH (port-forward + nc). 30s hard fail.
WAIT_SSH=0
SSH_READY_TIMEOUT=30
# Max concurrent virtctl port-forward probes (override: SSH_PROBE_PARALLEL=N).
SSH_PROBE_PARALLEL=1000
# Max concurrent `virtctl stop` calls before delete (override: STOP_PARALLEL=N,
# default 200 -- read via "${STOP_PARALLEL:-200}" at the call site; no
# top-level default assignment here, since that would unconditionally
# overwrite an env-supplied override before it's ever read).
# Max seconds to wait for VMs to actually reach Stopped after `virtctl stop`
# before giving up and proceeding with delete anyway (override:
# STOP_WAIT_TIMEOUT=N, default 1800 -- same reasoning, read via
# "${STOP_WAIT_TIMEOUT:-1800}" at the call site).
# JSON blob for manifest: vm_ssh_ready / vm_ssh_failed / ssh_ready_*
BATCH_SSH_JSON=
# Set to 1 by wait_for_batch_datavolumes_for_timestamps if its deadline is hit
# with DVs still pending; surfaced on the manifest as dv_wait_timed_out so a
# "final" manifest can be distinguished from one truncated by the wait timeout.
DV_WAIT_TIMED_OUT=0
CONTAINERDISK_IMAGE=
RECREATE_EXISTING_VMS=0
DELETE_BATCH=
DELETE_ALL=0
CONFIRM_DELETE=0
PROFILE_TARGET=
PROFILER_BIN=
PROFILER_DOWNLOAD_URL="https://github.com/gqlo/vstorm/releases/latest/download/cluster-profiler-linux-amd64"
declare -A expected_vms=()
# VMs that already exist on the cluster (populated once by create_virtualmachines
# on its first call, reused across --ns-sequential-creation groups so we don't re-list
# every group).
declare -A existing_vms=()
# Set to 1 once create_virtualmachines has built its per-run templates
# (cloud-init, data disk, existing_vms, ...) so repeated calls -- one per
# --ns-sequential-creation group -- reuse them instead of recomputing/re-listing.
VM_TEMPLATES_READY=0
# Validated template paths, keyed by role.  Filled by
# validate_required_templates; read by creation functions.
declare -A TEMPLATE_CACHE=()

wet_run=1
quiet=0
LOG_DIR="logs"
LOG_FILE=

if [[ -t 1 ]] ; then
    C_VAL=$'\033[0;36m'
    C_ERR=$'\033[0;31m'
    C_WARN=$'\033[0;33m'
    C_OK=$'\033[0;32m'
    C_BOLD=$'\033[1m'
    C_RST=$'\033[0m'
else
    C_VAL= C_ERR= C_WARN= C_OK= C_BOLD= C_RST=
fi

fatal() {
    echo "${C_ERR}$*${C_RST}" >&2
    exit 1
}

usage_error() {
    echo "${C_ERR}$*${C_RST}" >&2
    echo "Try '$0 --help' for more information." >&2
    exit 1
}

validate_subnet() {
    local cidr=$1
    [[ -n "$cidr" ]] || fatal "--udn-l2 requires a non-empty IPv4 CIDR (e.g. 10.132.10.0/16)"
    if ! [[ "$cidr" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])$ ]]; then
	fatal "Invalid --udn-l2='$cidr'; expected IPv4 CIDR (e.g. 10.132.10.0/16)"
    fi
}

# Reject basenames containing '.' — guest cloud-init heartbeats default to
# hostname -s, which truncates at the first dot (e.g. dirty-mem-0.25-* →
# dirty-mem-0), breaking per-VM result sync on the collector dashboard.
validate_vm_basename() {
    [[ -n "$VM_BASENAME" ]] || return 0
    [[ "$VM_BASENAME" == *.* ]] || return 0
    fatal "Invalid --basename '${VM_BASENAME}': must not contain '.' (guest hostname -s truncates at the first dot, breaking boot/result vm_name). Use e.g. dirty-mem-025 instead of dirty-mem-0.25"
}

validate_service_port() {
    local port=$1
    if ! [[ "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
	fatal "Invalid port '$port' in --service; use 1-65535"
    fi
}

parse_service_value() {
    local value=${1:-}
    VM_SERVICE=1
    VM_SERVICE_TYPE=nodeport
    VM_SERVICE_PORT=22
    VM_SERVICE_TARGET_PORT=22
    [[ -n "$value" ]] || return 0

    local type_part rest
    if [[ "$value" == *:* ]]; then
	IFS=: read -r type_part rest <<< "$value"
	type_part=${type_part,,}
    else
	type_part=${value,,}
	rest=
    fi

    case "$type_part" in
	nodeport|clusterip) VM_SERVICE_TYPE=$type_part ;;
	*) fatal "Invalid --service value '$value'; use TYPE[:PORT[:TARGET_PORT]] (TYPE: nodeport or clusterip; default port/targetPort 22)" ;;
    esac

    if [[ -n "$rest" ]]; then
	local port_part target_part
	if [[ "$rest" == *:* ]]; then
	    IFS=: read -r port_part target_part <<< "$rest"
	else
	    port_part=$rest
	    target_part=
	fi
	validate_service_port "$port_part"
	VM_SERVICE_PORT=$port_part
	if [[ -n "$target_part" ]]; then
	    validate_service_port "$target_part"
	    VM_SERVICE_TARGET_PORT=$target_part
	else
	    VM_SERVICE_TARGET_PORT=$port_part
	fi
    fi
}

validate_args() {
    # Detect options misplaced after positional arguments.  Bash getopts
    # stops at the first non-option word, so any --option that appears
    # after a positional argument is silently treated as a positional
    # argument instead of being parsed.  Catch that mistake early.
    for _arg in "$@"; do
	if [[ "$_arg" == --* ]]; then
	    fatal "Misplaced option '$_arg': all options must appear before positional arguments. Run '$0 -h' for usage."
	fi
    done

    if [[ -z "$DELETE_BATCH" ]] && (( ! DELETE_ALL )) ; then
	if (($# > 2)) ; then
	    usage_error "Error: too many positional arguments (expected at most 2, got $#)"
	fi

	if [[ -n "${1:-}" ]] && ! [[ "$1" =~ ^[0-9]+$ ]]; then
	    fatal "Invalid argument '$1': expected a number for total VMs"
	fi
	if [[ -n "${2:-}" ]] && ! [[ "$2" =~ ^[0-9]+$ ]]; then
	    fatal "Invalid argument '$2': expected a number for namespaces"
	fi

	NUM_VMS=${1:-$NUM_VMS}
	NUM_NAMESPACES=${2:-$NUM_NAMESPACES}

	if [[ -n "$NUM_VMS_PER_NAMESPACE" ]] ; then
	    NUM_VMS=$((NUM_VMS_PER_NAMESPACE * NUM_NAMESPACES))
	fi

	if ! [[ "$NUM_VMS" =~ ^[0-9]+$ && "$NUM_VMS" -ge 1 ]]; then
	    usage_error "Error: Number of VMs must be a positive integer"
	fi

	if ! [[ "$NUM_NAMESPACES" =~ ^[0-9]+$ && "$NUM_NAMESPACES" -ge 1 ]]; then
	    usage_error "Error: Number of namespaces must be a positive integer"
	fi

	if ((NUM_VMS < NUM_NAMESPACES)) ; then
	    usage_error "Error: Number of VMs must be greater than or equal to number of namespaces"
	fi

	if ((UDN_L2)); then
	    validate_subnet "$SUBNET"
	fi

	case "$RUN_STRATEGY" in
	    Always|Halted|Manual|RerunOnFailure) ;;
	    *) usage_error "Invalid --run-strategy '$RUN_STRATEGY'; must be one of: Always, Halted, Manual, RerunOnFailure" ;;
	esac

	if ((ACCESS_MODE_SET)) ; then
	    case "$ACCESS_MODE" in
		ReadWriteOnce|ReadWriteMany|ReadOnlyMany) ;;
		*) usage_error "Invalid --access-mode '$ACCESS_MODE'; must be one of: ReadWriteOnce, ReadWriteMany, ReadOnlyMany" ;;
	    esac
	fi

	if ((VOLUME_MODE_SET)) ; then
	    case "$VOLUME_MODE" in
		Block|Filesystem) ;;
		*) usage_error "Invalid --volume-mode '$VOLUME_MODE'; must be one of: Block, Filesystem" ;;
	    esac
	fi

	# --containerdisk is mutually exclusive with --datasource and --dv-url
	if [[ -n "$CONTAINERDISK_IMAGE" ]] && { [[ -n "$DATASOURCE" ]] || [[ -n "$DV_URL" ]] ; } ; then
	    fatal "--containerdisk cannot be combined with --datasource or --dv-url"
	fi

	# Blank data disk is opt-in via --data-disk-size=N; 0 clears it if set.
	if [[ "$DATA_DISK_SIZE" == "0" ]] ; then
	    DATA_DISK_SIZE=""
	elif [[ -n "$DATA_DISK_SIZE" ]] && [[ ! "$DATA_DISK_SIZE" =~ ^[0-9]+([KMGT]i?)?$ ]]; then
	    usage_error "Invalid --data-disk-size '$DATA_DISK_SIZE' (example: 20G or 50Gi; omit or use 0 for none)"
	fi

	validate_vm_basename
    fi
}

derive_defaults() {
    # Auto-derive VM_BASENAME from the DataSource name when the user
    # hasn't explicitly set --basename.
    if [[ -n "$DATASOURCE" ]] && (( ! BASENAME_SET )) ; then
	VM_BASENAME="$DATASOURCE"
    elif [[ -n "$CONTAINERDISK_IMAGE" ]] && (( ! BASENAME_SET )) ; then
	_cdimg=${CONTAINERDISK_IMAGE##*/}
	VM_BASENAME="${_cdimg%%:*}"
    fi

    # Always keep BASE_PVC_NAME in sync with VM_BASENAME unless the user
    # explicitly set --pvc-base-name.  Previously this derivation only ran
    # inside the DATASOURCE block, so --dv-url + --basename left
    # BASE_PVC_NAME at the default while the DV template created
    # a PVC named "{VM_BASENAME}-base", causing VolumeSnapshot to reference
    # a non-existent PVC.  Empty basename → "base" (no leading dash).
    if (( ! PVC_BASE_NAME_SET )) ; then
	if [[ -n "$VM_BASENAME" ]]; then
	    BASE_PVC_NAME="${VM_BASENAME}-base"
	else
	    BASE_PVC_NAME="base"
	fi
    fi

    # Auto-disable snapshots when a custom storage class is used without
    # a matching snapshot class.  The hardcoded SNAPSHOT_CLASS only works
    # with the default OCS STORAGE_CLASS, so using a different storage class
    # without providing a snapshot class means snapshots won't work.
    if (( ! SNAPSHOT_EXPLICITLY_SET && STORAGE_CLASS_SET && ! SNAPSHOT_CLASS_SET )); then
	USE_SNAPSHOT=0
    fi
}

