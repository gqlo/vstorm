	    log_message "${C_OK}All VM namespaces fully cleaned up${C_RST} (no leftover namespaces, PVCs, PVs, or VolumeAttachments)"
	    return 0
	fi

	if (( SECONDS >= deadline )) ; then
	    echo ""
	    rm -f "$ns_file"
	    log_message "${C_WARN}Timed out after ${timeout}s waiting for VM namespace cleanup; leftovers remain: namespaces=$ns_n PVCs=$pvc_n PVs=$pv_n VolumeAttachments=$va_n${C_RST}"
	    return 1
	fi

	sleep "$interval"
    done
}

################################################################
# Delete a non-vstorm namespace and all VMs inside it.
# Args: $1 = namespace, $2 = "skip-confirm" (optional)
delete_vm_namespace() {
    local ns=$1
    local skip_confirm=${2:-}

    if is_protected_delete_namespace "$ns" ; then
	fatal "Refusing to delete protected namespace '$ns'"
    fi

    if ((! wet_run)) ; then
	echo "(dry-run) Would delete namespace '$ns' and all its VMs:"
	echo "  virtctl stop <vm> -n $ns   (all VMs, in parallel, up to ${STOP_PARALLEL:-200} at a time)"
	echo "  oc delete ns $ns --wait=false"
	echo ""
	echo "(dry-run) Would wait (up to ${STOP_WAIT_TIMEOUT:-1800}s) for all VMs to reach Stopped"
	echo "before deleting the namespace, then monitor leftover PVCs/PVs/VolumeAttachments,"
	echo "refreshing counts every ${DELETE_POLL_INTERVAL:-2}s until all reach zero."
	return 0
    fi

    local vm_list vm_count
    vm_list=$(oc get vm -n "$ns" --no-headers 2>/dev/null | awk -v ns="$ns" '{print ns, $1}') || true
    [[ -z "$vm_list" ]] && vm_count=0 || vm_count=$(echo "$vm_list" | wc -l)

    echo "Resources in namespace '$ns':"
    echo ""
    echo "VirtualMachines: $vm_count"
    echo ""

    if (( ! CONFIRM_DELETE )) && [[ "$skip_confirm" != "skip-confirm" ]] ; then
	read -r -p "Delete namespace '$ns' and its VMs? [y/N] " confirm
	if [[ "${confirm,,}" != "y" ]] ; then
	    echo "Aborted."
	    return 0
	fi
    fi

    stop_namespace_vms "$ns" "$vm_list"

    log_message "Deleting namespace ${C_VAL}'$ns'${C_RST}..."
    oc delete ns "$ns" --wait=false
    watch_namespace_delete_cleanup "$ns"
}

################################################################
# Delete all resources for a batch
# Args: $1 = batch ID, $2 = "skip-confirm" (optional, used by delete_all_batches)
delete_batch() {
    local batch=$1
    local skip_confirm=${2:-}

    if ((! wet_run)) ; then
        echo "(dry-run) Would delete all resources for batch '$batch':"
        echo "  virtctl stop <vm> -n <namespace>   (all VMs, in parallel, up to ${STOP_PARALLEL:-200} at a time)"
        echo "  oc delete ns -l batch-id=$batch --wait=false"
        echo ""
        echo "This deletes all namespaces, VMs, DataVolumes, VolumeSnapshots,"
        echo "and PVCs belonging to batch '$batch'."
        echo "(dry-run) Would wait (up to ${STOP_WAIT_TIMEOUT:-1800}s) for all VMs to reach Stopped"
        echo "before deleting namespaces, then monitor leftover namespaces/PVCs/PVs/VolumeAttachments,"
        echo "refreshing counts every ${DELETE_POLL_INTERVAL:-2}s until all reach zero."
        return 0
    fi

    # Show what will be deleted (counts only, not full listing)
    local ns_list ns_count vm_list vm_count
    ns_list=$(oc get ns -l batch-id="$batch" --no-headers 2>/dev/null | awk '{print $1}') || true
    [[ -z "$ns_list" ]] && ns_count=0 || ns_count=$(echo "$ns_list" | wc -l)
    vm_list=$(oc get vm -A -l batch-id="$batch" --no-headers 2>/dev/null | awk '{print $1, $2}') || true
    [[ -z "$vm_list" ]] && vm_count=0 || vm_count=$(echo "$vm_list" | wc -l)

    echo "Resources for batch '$batch':"
    echo ""
    echo "Namespaces: $ns_count"
    echo "VirtualMachines: $vm_count"
    echo ""

    # Check if anything exists
    if ((ns_count == 0)) ; then
        echo "No resources found for batch '$batch'"
        return 0
    fi

    # Safety: verify all matching namespaces look like vstorm-created ones.
    # This prevents accidental deletion of operator/system namespaces that
    # may have been manually tagged with a batch-id label.
    local ns_name
    while read -r ns_name ; do
	if [[ -n "$ns_name" ]] && ! is_vstorm_batch_namespace "$batch" "$ns_name" ; then
	    fatal "Refusing to delete namespace '$ns_name': does not match vstorm naming pattern ({batch}-ns-{N} or vm-{batch}-ns-{N})"
	fi
    done <<< "$ns_list"

    # Confirmation prompt (unless --yes or called from delete_all_batches)
    if (( ! CONFIRM_DELETE )) && [[ "$skip_confirm" != "skip-confirm" ]] ; then
	read -r -p "Delete these resources? [y/N] " confirm
	if [[ "${confirm,,}" != "y" ]] ; then
	    echo "Aborted."
	    return 0
	fi
    fi

    # Gracefully stop all VMs (parallel `virtctl stop`) before their
    # namespaces are torn down, rather than letting namespace deletion
    # abruptly kill running VMIs. Also waits (best-effort) for the stop to
    # actually take effect before proceeding.
    stop_batch_vms "$batch" "$vm_list"

    # Delete namespaces (cascades VMs, DVs, snapshots, PVCs). --wait=false
    # returns immediately so we can monitor leftover cluster-scoped storage
    # (PVs, VolumeAttachments) ourselves instead of blocking silently until
    # every finalizer clears.
    log_message "Deleting namespaces for batch ${C_VAL}'$batch'${C_RST}..."
    oc delete ns -l batch-id="$batch" --wait=false
    watch_batch_delete_cleanup "$batch"
}

################################################################
# Delete all namespaces containing VirtualMachines on the cluster
delete_all_batches() {
    local vm_ns_list

    if ((! wet_run)) ; then
	cat <<-EOF
	(dry-run) Would discover VM namespaces (oc get vm -A), stop all VMs
	across those namespaces, delete the namespaces, and monitor cleanup
	(excludes openshift/kube system namespaces)
	EOF
	return 0
    fi

    vm_ns_list=$(discover_vm_namespaces)

    if [[ -z "$vm_ns_list" ]] ; then
	echo "No VM namespaces found on the cluster."
	return 0
    fi

    echo "Found VM namespaces:"
    local ns vm_count total_vms=0 ns_count=0
    while read -r ns ; do
	vm_count=$(oc get vm -n "$ns" --no-headers 2>/dev/null | wc -l)
	echo "  $ns  ($vm_count VMs)"
	total_vms=$((total_vms + vm_count))
	ns_count=$((ns_count + 1))
    done <<< "$vm_ns_list"
    echo ""
    echo "Total: $ns_count namespace(s), $total_vms VM(s)"
    echo ""

    # Confirmation (unless --yes)
    if (( ! CONFIRM_DELETE )) ; then
	read -r -p "Delete ALL VM namespaces above? This is irreversible. [y/N] " confirm
	if [[ "${confirm,,}" != "y" ]] ; then
	    echo "Aborted."
	    return 0
	fi
    fi

    local vm_list
    vm_list=$(discover_vm_list "$vm_ns_list")

    if stop_vms "$vm_list"; then
	wait_for_vms_stopped "$vm_list" || true
    fi

    log_message "Deleting ${C_VAL}${ns_count}${C_RST} VM namespace(s)..."
    while read -r ns ; do
	[[ -n "$ns" ]] || continue
	oc delete ns "$ns" --wait=false
    done <<< "$vm_ns_list"

    watch_vm_namespaces_delete_cleanup "$vm_ns_list"

    log_message "${C_OK}All VM namespaces deleted.${C_RST}"
}

################################################################
# Cluster profiler functions
ensure_profiler_binary() {
    # 1. Check if cluster-profiler is on PATH
    if command -v cluster-profiler &>/dev/null ; then
	PROFILER_BIN=$(command -v cluster-profiler)
	log_message "Using cluster-profiler from PATH: ${C_VAL}$PROFILER_BIN${C_RST}"
	return 0
    fi

    # 2. Check cached binary
    local cache_dir="$HOME/.vstorm/bin"
    local cached_bin="$cache_dir/cluster-profiler"
    if [[ -x "$cached_bin" ]] ; then
	PROFILER_BIN="$cached_bin"
	log_message "Using cached cluster-profiler: ${C_VAL}$PROFILER_BIN${C_RST}"
	return 0
    fi

    # 3. Download pre-built binary from GitHub Releases
    log_message "Downloading cluster-profiler binary..."
    mkdir -p "$cache_dir"

    if command -v curl &>/dev/null ; then
	curl -fsSL -o "$cached_bin" "$PROFILER_DOWNLOAD_URL" ||
	    fatal "Failed to download cluster-profiler from $PROFILER_DOWNLOAD_URL"
    elif command -v wget &>/dev/null ; then
	wget -q -O "$cached_bin" "$PROFILER_DOWNLOAD_URL" ||
	    fatal "Failed to download cluster-profiler from $PROFILER_DOWNLOAD_URL"
    else
	fatal "Neither curl nor wget is available. Install cluster-profiler manually or install curl/wget."
    fi

    chmod +x "$cached_bin"
    PROFILER_BIN="$cached_bin"
    log_message "cluster-profiler binary downloaded to: ${C_VAL}$PROFILER_BIN${C_RST}"
}

ensure_profiler_feature_gate() {
    # Detect OCP/Virtualization vs upstream KubeVirt
    local hco_exists
    hco_exists=$(oc get hco kubevirt-hyperconverged -n openshift-cnv -o name 2>/dev/null) || true

    if [[ -n "$hco_exists" ]] ; then
	# OCP/Virtualization: check via jsonpatch annotation on HCO CR
	local annotation
	annotation=$(oc get hco kubevirt-hyperconverged -n openshift-cnv \
	    -o jsonpath='{.metadata.annotations.kubevirt\.kubevirt\.io/jsonpatch}' \
	    2>/dev/null) || true

	if echo "$annotation" | grep -q "ClusterProfiler" ; then
	log_message "${C_OK}ClusterProfiler feature gate is already enabled (OCP/Virtualization)${C_RST}"
	    return 0
	fi

	cat <<-EOF

	ClusterProfiler feature gate is not enabled on this cluster.
	This is required for profiling KubeVirt control-plane components.

	EOF
	read -r -p "Enable ClusterProfiler feature gate now? [y/N] " confirm
	if [[ "${confirm,,}" != "y" ]] ; then
	    fatal "Profiling requires the ClusterProfiler feature gate. Aborting."
	fi

	log_message "${C_BOLD}Enabling ClusterProfiler feature gate via HCO annotation...${C_RST}"
	if [[ -z "$annotation" || "$annotation" == "null" ]] ; then
	    # No existing jsonpatch annotation -- simple case
	    oc annotate --overwrite -n openshift-cnv hco kubevirt-hyperconverged \
		'kubevirt.kubevirt.io/jsonpatch=[{"op": "add", "path": "/spec/configuration/developerConfiguration/featureGates/-", "value": "ClusterProfiler"}]' ||
		fatal "Failed to enable ClusterProfiler feature gate"
	else
	    # Existing annotation present -- need to merge
	    # Parse the existing JSON array and append the ClusterProfiler entry
	    local new_entry='{"op": "add", "path": "/spec/configuration/developerConfiguration/featureGates/-", "value": "ClusterProfiler"}'
	    local merged
	    # Remove trailing ] and append new entry
	    merged="${annotation%]}, ${new_entry}]"
	    oc annotate --overwrite -n openshift-cnv hco kubevirt-hyperconverged \
		"kubevirt.kubevirt.io/jsonpatch=${merged}" ||
		fatal "Failed to enable ClusterProfiler feature gate"
	fi
	log_message "${C_OK}ClusterProfiler feature gate enabled.${C_RST} Waiting for rollout..."
	sleep 5
    else
	# Upstream KubeVirt: check feature gates directly on KubeVirt CR
	local feature_gates
	feature_gates=$(oc get kubevirt kubevirt -n kubevirt \
	    -o jsonpath='{.spec.configuration.developerConfiguration.featureGates}' \
	    2>/dev/null) || true

	if echo "$feature_gates" | grep -q "ClusterProfiler" ; then
	    log_message "${C_OK}ClusterProfiler feature gate is already enabled (upstream KubeVirt)${C_RST}"
	    return 0
	fi

	cat <<-EOF

	ClusterProfiler feature gate is not enabled on this cluster.
	This is required for profiling KubeVirt control-plane components.

	EOF
	read -r -p "Enable ClusterProfiler feature gate now? [y/N] " confirm
	if [[ "${confirm,,}" != "y" ]] ; then
	    fatal "Profiling requires the ClusterProfiler feature gate. Aborting."
	fi

	log_message "${C_BOLD}Enabling ClusterProfiler feature gate on KubeVirt CR...${C_RST}"
	oc patch kubevirt kubevirt -n kubevirt --type=json \
	    -p '[{"op": "add", "path": "/spec/configuration/developerConfiguration/featureGates/-", "value": "ClusterProfiler"}]' ||
	    fatal "Failed to enable ClusterProfiler feature gate"
	log_message "${C_OK}ClusterProfiler feature gate enabled.${C_RST} Waiting for rollout..."
	sleep 5
    fi
}

profiler_start() {
    log_message "${C_BOLD}Starting KubeVirt control-plane profiling...${C_RST}"
    "$PROFILER_BIN" --cmd start ||
	fatal "Failed to start cluster profiling"
    log_message "${C_OK}Profiling started successfully${C_RST}"
}

profiler_prompt_and_stop() {
    echo ""
    echo "================================================================"
    echo "  Cluster profiling is in progress"
    echo "  KubeVirt control plane profiling is active (CPU, memory, etc.)"
    echo "================================================================"
    echo ""
    read -r -p "Press Enter to stop profiling and dump results (or Ctrl+C to abort)..."
    echo ""

    log_message "${C_BOLD}Stopping KubeVirt control-plane profiling...${C_RST}"
    "$PROFILER_BIN" --cmd stop ||
	fatal "Failed to stop cluster profiling"
    log_message "${C_OK}Profiling stopped${C_RST}"

    local output_dir="${LOG_DIR}/profile-${BATCH_ID}"
    log_message "Dumping profiling results to ${C_VAL}$output_dir${C_RST}..."

    if [[ "$PROFILE_TARGET" == "all" ]] ; then
	"$PROFILER_BIN" --cmd dump --output-dir "$output_dir" ||
	    fatal "Failed to dump profiling results"
    else
	"$PROFILER_BIN" --cmd dump --l "kubevirt.io=$PROFILE_TARGET" --output-dir "$output_dir" ||
	    fatal "Failed to dump profiling results for $PROFILE_TARGET"
    fi

    log_message "${C_OK}Profiling results saved to:${C_RST} ${C_VAL}$output_dir${C_RST}"
    echo ""
    echo "Profiling results: $output_dir"
    echo "Analyze with: go tool pprof $output_dir/<pod>/<profile>.pprof"
    echo "Plot with:    go tool pprof -svg $output_dir/<pod>/cpu.pprof > cpu.svg"
}


################################################################
# Main execution
main() {
    prepare_creation
    log_message "${C_BOLD}Starting resource creation process...${C_RST}"
    log_message "Batch ID:      ${C_VAL}$BATCH_ID${C_RST}"
    log_message "Configuration: ${C_VAL}$NUM_VMS${C_RST} VMs across ${C_VAL}$NUM_NAMESPACES${C_RST} namespaces"

    if [[ -n "$CONTAINERDISK_IMAGE" ]] ; then
	log_message "ContainerDisk: ${C_VAL}$CONTAINERDISK_IMAGE${C_RST}"
    elif [[ -n "$DATASOURCE" ]] ; then
	log_message "DataSource:    ${C_VAL}$DATASOURCE${C_RST} (from ${C_VAL}$DATASOURCE_NS${C_RST})"
    else
	log_message "DV URL:        ${C_VAL}$DV_URL${C_RST}"
	log_message "Storage size:  ${C_VAL}$STORAGE_SIZE${C_RST}"
    fi
    if [[ -n "$DATA_DISK_SIZE" ]] ; then
	log_message "Data disk:     ${C_VAL}$DATA_DISK_SIZE${C_RST} (blank vdb)"
    fi
    if [[ -z "$CONTAINERDISK_IMAGE" || -n "$DATA_DISK_SIZE" ]] ; then
	log_message "Storage class: ${C_VAL}$STORAGE_CLASS${C_RST}"
	log_message "Volume mode:   ${C_VAL}$VOLUME_MODE${C_RST}"
	if [[ -z "$CONTAINERDISK_IMAGE" ]] ; then
	    if ((USE_SNAPSHOT)) ; then
		log_message "Snapshot mode: enabled (class: ${C_VAL}$SNAPSHOT_CLASS${C_RST})"
	    elif [[ -n "$DATASOURCE" ]] ; then
		log_message "Snapshot mode: disabled (direct DataSource clone)"
	    else
		log_message "Snapshot mode: disabled (direct PVC clone)"
	    fi
	fi
    fi
    log_message "VM CPU cores:  ${C_VAL}$VM_CPU_CORES${C_RST}"
    log_message "VM memory:     ${C_VAL}$VM_MEMORY${C_RST}"
    log_message "VM firmware:   ${C_VAL}$VM_FIRMWARE${C_RST}"
    log_message "Cloud-init:    ${C_VAL}${CLOUDINIT_FILE:-none}${C_RST}"
    log_message "Run strategy:  ${C_VAL}$RUN_STRATEGY${C_RST}"
    if ((WAIT_SSH)); then
	log_message "Wait SSH:      ${C_VAL}yes (${SSH_READY_TIMEOUT}s)${C_RST}"
    elif ((WAIT)); then
	log_message "Wait VMs:      ${C_VAL}yes${C_RST}"
    fi
    if ((NS_SEQUENTIAL_CREATION)); then
	log_message "NS sequential: ${C_VAL}true${C_RST} (--ns-sequential-creation: one namespace at a time)"
    fi

    if ((NS_SEQUENTIAL_CREATION)) ; then
	log_message "${C_BOLD}ns-sequential-creation enabled:${C_RST} creating/waiting one namespace at a time"
	local -i seq_ns is_last_ns
	for ((seq_ns=1; seq_ns<=NUM_NAMESPACES; seq_ns++)); do
	    is_last_ns=$((seq_ns == NUM_NAMESPACES ? 1 : 0))
	    log_message "${C_BOLD}Namespace ${C_VAL}${seq_ns}${C_RST}${C_BOLD} of ${C_VAL}${NUM_NAMESPACES}${C_RST}"
	    create_namespaces "$seq_ns" "$seq_ns"
	    if [[ -z "$CONTAINERDISK_IMAGE" ]] ; then
		create_datavolumes "$seq_ns" "$seq_ns"
		if ((USE_SNAPSHOT)) ; then
		    create_volumesnapshots "$seq_ns" "$seq_ns"
		elif ((seq_ns == 1)) ; then
		    log_message "Skipping VolumeSnapshots (${C_VAL}--no-snapshot${C_RST} mode)"
		fi
	    fi
	    # Force a wait for this namespace's VMs to reach Running before
	    # moving on -- otherwise --ns-sequential-creation would just reorder the
	    # same burst of creates with no throttling effect. The final
	    # namespace still honors --wait for whether create returns
	    # only once everything is Running.
	    create_virtualmachines "$seq_ns" "$seq_ns" $((is_last_ns ? 0 : 1))
	    if ((VM_SERVICE)); then
		create_vm_service "$seq_ns" "$seq_ns"
	    fi
	    # Post an incremental progress manifest as soon as this namespace's
	    # resources are created, so the dashboard/result server reflects
	    # progress namespace-by-namespace instead of only once after the
	    # whole --ns-sequential-creation loop finishes.
	    if ((wet_run)) && _result_server_url_configured; then
		BATCH_DV_CREATED_JSON=$(collect_batch_dv_created_json)
		post_batch_result_metadata progress
	    fi
	done
    else
	create_namespaces
	if [[ -z "$CONTAINERDISK_IMAGE" ]] ; then
	    create_datavolumes
	    if ((USE_SNAPSHOT)) ; then
		create_volumesnapshots
	    else
		log_message "Skipping VolumeSnapshots (${C_VAL}--no-snapshot${C_RST} mode)"
	    fi
	fi
	create_virtualmachines
	if ((VM_SERVICE)); then
	    create_vm_service
	fi
    fi

    # TODO: re-enable once verify_cloudinit is improved
    # if ((wet_run && WAIT)) && [[ -n "$CLOUDINIT_FILE" ]]; then
    #     verify_cloudinit
    # fi

    local ssh_verify_failed=0
    if ((wet_run && WAIT_SSH)); then
	if ! verify_ssh_port; then
	    ssh_verify_failed=1
	fi
    fi

    if ((wet_run)) ; then
	if ((ssh_verify_failed)); then
	    log_message "${C_WARN}Resource creation finished but SSH port check failed${C_RST}"
	else
	    log_message "${C_OK}Resource creation completed successfully!${C_RST}"
	fi
	if [[ -n "$CONTAINERDISK_IMAGE" ]] ; then
	    log_message "Created ${C_VAL}$NUM_NAMESPACES${C_RST} namespaces and ${C_VAL}$NUM_VMS${C_RST} total VirtualMachines (container disk)"
	elif ((USE_SNAPSHOT)) ; then
	    log_message "Created ${C_VAL}$NUM_NAMESPACES${C_RST} namespaces, ${C_VAL}$NUM_NAMESPACES${C_RST} DataVolumes, ${C_VAL}$NUM_NAMESPACES${C_RST} VolumeSnapshots, and ${C_VAL}$NUM_VMS${C_RST} total VirtualMachines"
	elif [[ -n "$DATASOURCE" ]] ; then
	    log_message "Created ${C_VAL}$NUM_NAMESPACES${C_RST} namespaces and ${C_VAL}$NUM_VMS${C_RST} total VirtualMachines (direct DataSource clone, no base DVs)"
	else
	    log_message "Created ${C_VAL}$NUM_NAMESPACES${C_RST} namespaces, ${C_VAL}$NUM_NAMESPACES${C_RST} DataVolumes, and ${C_VAL}$NUM_VMS${C_RST} total VirtualMachines (no snapshots)"
	fi

	# Write batch manifest file
	local manifest_file="${LOG_DIR}/batch-${BATCH_ID}.manifest"
	local ns_list=""
	local vm_list=""
	local dv_created_json="{}"
	# Early progress manifest: makes the batch visible on the dashboard
	# right after VMs are created, well before large-scale DV cloning
	# finishes. wait_for_batch_datavolumes_for_timestamps posts further
	# progress updates as DVs become Ready/Bound; the final POST below
	# always has the complete picture regardless.
	if _result_server_url_configured; then
	    dv_created_json=$(collect_batch_dv_created_json)
	    BATCH_DV_CREATED_JSON="$dv_created_json"
	    post_batch_result_metadata progress
	fi
	# Per-VM / blank data DVs are created with the VMs; wait for Succeeded
	# so ready/bound timestamps are present even without --wait.
	wait_for_batch_datavolumes_for_timestamps
	dv_created_json=$(collect_batch_dv_created_json)
	BATCH_DV_CREATED_JSON="$dv_created_json"
	local dv_summary_file
	dv_summary_file=$(mktemp)
	printf '%s\n' "$dv_created_json" > "$dv_summary_file"
	local base_dv_created_at_line="" base_dv_ready_at_line="" base_dv_bound_at_line=""
	local snapshot_created_at_line="" snapshot_ready_at_line=""
	local dv_created_at_line="" pvc_created_at_line="" dv_ready_at_line="" pvc_bound_at_line=""
	local ssh_ready_at_line="" ssh_ready_status_line="" ssh_failed_line=""
	# One python pass via file — avoid MAX_ARG_STRLEN on large DV_CREATED_JSON.
	eval "$(
	    python3 -c '
import json, shlex, sys
path = sys.argv[1]
try:
    d = json.load(open(path, encoding="utf-8"))
except Exception:
    d = {}
keys = [
    ("base_dv_created_at", "base_dv_created_at_line"),
    ("base_dv_ready_at", "base_dv_ready_at_line"),
    ("base_dv_bound_at", "base_dv_bound_at_line"),
    ("snapshot_created_at", "snapshot_created_at_line"),
    ("snapshot_ready_at", "snapshot_ready_at_line"),
    ("dv_created_at", "dv_created_at_line"),
    ("dv_ready_at", "dv_ready_at_line"),
    ("pvc_created_at", "pvc_created_at_line"),
]
for src, dest in keys:
    print("%s=%s" % (dest, shlex.quote(str(d.get(src) or ""))))
bound = d.get("pvc_bound_at") or d.get("dv_bound_at") or ""
print("pvc_bound_at_line=%s" % shlex.quote(str(bound)))
' "$dv_summary_file" 2>/dev/null || true
	)"
	rm -f "$dv_summary_file"
	if [[ -n "${BATCH_SSH_JSON:-}" && "$BATCH_SSH_JSON" != "{}" ]]; then
	    local ssh_summary_file
	    ssh_summary_file=$(mktemp)
	    printf '%s\n' "$BATCH_SSH_JSON" > "$ssh_summary_file"
	    eval "$(
		python3 -c '
import json, shlex, sys
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    d = {}
print("ssh_ready_at_line=%s" % shlex.quote(str(d.get("ssh_ready_at") or "")))
print("ssh_ready_status_line=%s" % shlex.quote(str(d.get("ssh_ready_status") or "")))
print("ssh_failed_line=%s" % shlex.quote(",".join(d.get("vm_ssh_failed") or [])))
' "$ssh_summary_file" 2>/dev/null || true
	    )"
	    rm -f "$ssh_summary_file"
	fi
	for ((ns=1; ns<=NUM_NAMESPACES; ns++)); do
	    local ns_name="${BATCH_ID}-ns-${ns}"
	    ns_list="${ns_list:+${ns_list}, }${ns_name}"
	done
	for key in "${BATCH_VMS_ORDERED[@]+"${BATCH_VMS_ORDERED[@]}"}" ; do
	    vm_list="${vm_list:+${vm_list}, }${key}"
	done
	cat > "$manifest_file" <<-MANIFEST
	batch-id: $BATCH_ID
	created: $(date -u +%Y-%m-%dT%H:%M:%SZ)
	basename: $VM_BASENAME
	total-vms: $NUM_VMS
	total-namespaces: $NUM_NAMESPACES
	namespaces: $ns_list
	vms: $vm_list
	base-dv-created-at: ${base_dv_created_at_line:-}
	base-dv-ready-at: ${base_dv_ready_at_line:-}
	base-dv-bound-at: ${base_dv_bound_at_line:-}
	snapshot-created-at: ${snapshot_created_at_line:-}
	snapshot-ready-at: ${snapshot_ready_at_line:-}
	dv-created-at: ${dv_created_at_line:-}
	dv-ready-at: ${dv_ready_at_line:-}
	pvc-created-at: ${pvc_created_at_line:-}
	pvc-bound-at: ${pvc_bound_at_line:-}
	ssh-ready-at: ${ssh_ready_at_line:-}
	ssh-ready-status: ${ssh_ready_status_line:-}
	ssh-failed: ${ssh_failed_line:-}
	MANIFEST
	if [[ "$dv_created_json" != "{}" && -n "$dv_created_json" ]]; then
	    printf '%s\n' "$dv_created_json" > "${LOG_DIR}/batch-${BATCH_ID}.dv-created.json"
	fi
	if [[ -n "${BATCH_SSH_JSON:-}" && "$BATCH_SSH_JSON" != "{}" ]]; then
	    printf '%s\n' "$BATCH_SSH_JSON" > "${LOG_DIR}/batch-${BATCH_ID}.ssh-ready.json"
	fi
	log_message "Batch manifest written to: ${C_VAL}$manifest_file${C_RST}"

	post_batch_result_metadata final

	if ((ssh_verify_failed)); then
	    fatal "SSH port check failed for one or more VMs (timeout ${SSH_READY_TIMEOUT}s). See log and ${LOG_DIR}/batch-${BATCH_ID}.ssh-ready.json"
	fi

	cat <<-EOF

	Batch ID: $BATCH_ID

	To check the created resources:
	  oc get ns -l batch-id=$BATCH_ID
	EOF
	if [[ -z "$CONTAINERDISK_IMAGE" ]] ; then
	    echo "  oc get datavolumes -A -l batch-id=$BATCH_ID"
	fi
	if ((USE_SNAPSHOT)) ; then
	    echo "  oc get volumesnapshots -A -l batch-id=$BATCH_ID"
	fi
	cat <<-EOF
	  oc get vm -A -l batch-id=$BATCH_ID
	EOF
	if ((VM_SERVICE)) && ((${#VM_SERVICE_INFO[@]} > 0)); then
	    local entry ns_name svc_type node_port svc_port target_port svc_host
	    if [[ "$VM_SERVICE_TYPE" == clusterip ]]; then
		local _hint_port=$VM_SERVICE_PORT
		if (( VM_SERVICE_TARGET_PORT != VM_SERVICE_PORT )); then
		    _hint_port="$VM_SERVICE_PORT (VM port $VM_SERVICE_TARGET_PORT)"
		fi
		cat <<-EOF

	Connect to VMs in each namespace (ClusterIP port $_hint_port; OVN load-balances across running VMs):
	EOF
	    else
		cat <<-EOF

	Connect to VMs in each namespace (NodePort on any cluster node; OVN load-balances across running VMs):
	EOF
	    fi
	    for entry in "${VM_SERVICE_INFO[@]}"; do
		IFS=: read -r ns_name svc_type node_port svc_port target_port <<< "$entry"
		if [[ "$svc_type" == clusterip ]]; then
		    svc_host="svc-clusterip-$(join_name "$VM_BASENAME" "$BATCH_ID").${ns_name}.svc.cluster.local"
		    if (( svc_port == 22 )); then
			echo "  ${ns_name}: ssh -o PubkeyAuthentication=no root@${svc_host}"
		    else
			echo "  ${ns_name}: <host>:${svc_port} via ${svc_host}"
		    fi
		else
		    if (( svc_port == 22 )); then
			if (( target_port != svc_port )); then
			    echo "  ${ns_name}: ssh -o PubkeyAuthentication=no root@<node-ip> -p ${node_port} (VM port ${target_port})"
			else
			    echo "  ${ns_name}: ssh -o PubkeyAuthentication=no root@<node-ip> -p ${node_port}"
			fi
		    else
			if (( target_port != svc_port )); then
			    echo "  ${ns_name}: <node-ip>:${node_port} -> service port ${svc_port} / VM port ${target_port}"
			else
			    echo "  ${ns_name}: <node-ip>:${node_port} -> port ${svc_port}"
			fi
		    fi
		fi
	    done
	fi
	cat <<-EOF

	To delete all resources in this batch:
	  oc delete vm -A -l batch-id=$BATCH_ID
	  oc delete ns -l batch-id=$BATCH_ID

	To list all batches:
	  ls ${LOG_DIR}/*.manifest
	EOF
    fi
}

# Run delete or create
validate_delete_and_profile_options
setup_logging
if (( DELETE_ALL )) ; then
    if ((wet_run)) ; then
	ensure_oc_ready
    fi
    delete_all_batches
elif [[ -n "$DELETE_BATCH" ]] ; then
    if ((wet_run)) ; then
	ensure_oc_ready
    fi
    delete_batch "$DELETE_BATCH"
else
    if [[ -n "$PROFILE_TARGET" ]] ; then
	if ((wet_run)) ; then
	    ensure_profiler_binary
	    ensure_profiler_feature_gate
	    profiler_start
	else
	    echo "(dry-run) Would ensure cluster-profiler binary is available"
	    echo "(dry-run) Would check/enable ClusterProfiler feature gate"
	    echo "(dry-run) Would start profiling before VM creation"
	fi
    fi
    main
    if [[ -n "$PROFILE_TARGET" ]] ; then
	if ((wet_run)) ; then
	    profiler_prompt_and_stop
	else
	    echo "(dry-run) Would prompt to stop profiling and dump results"
	fi
    fi
fi

# Print dry-run YAML file location
if [[ -n "${DRYRUN_FILE:-}" && -f "${DRYRUN_FILE:-}" ]] ; then
    echo ""
    echo "Dry-run YAML saved to: ${C_VAL}$DRYRUN_FILE${C_RST}"
fi
