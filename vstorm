}

################################################################
# Poll cluster-scoped storage still tied to a set of namespaces after delete.
# Args: $1 = newline-separated namespace names
watch_vm_namespaces_delete_cleanup() {
    local ns_list=$1
    local ns_file pv_names_file ns
